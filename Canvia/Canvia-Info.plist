<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The keys the build settings cannot hold, merged with the ones they
	generate. A Canvia design file (.canvia.json) is JSON, and arrives from
	Files, Mail or another app's share sheet as JSON; the app says it can
	open JSON, and checks what is inside rather than trusting the type, as
	the Android twin does. A copy is handed over (not opened in place), and
	the app deletes it once it has been read in.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Canvia design</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
