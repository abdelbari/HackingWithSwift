{
  "about": "Alignment a paragraph at a time on both phones (TextLists.alignOf, withAlign, setAlign): each entry of `paragraphs` may carry an \"align\" of its own, left out when it matches the box's `align` (centred when the box has none) and guarded by `paragraphsText` as list and level are. `reads` gives each line's alignment as both phones read it; `aligned` gives a box after the lines `lines` (zero-based, both ends in) are aligned `align` while typing — or every line at once with `box: true` — and the box's `align` and `paragraphs` after (null for none). Lines all aligned alike make that the box's align and no line keeps its own.",
  "reads": [
    {"name": "heading over body",
     "element": {"id": "a", "type": "text", "text": "Title\nBody one\nBody two", "align": "left",
       "paragraphs": [{"align": "center"}, {}, {}], "paragraphsText": "Title\nBody one\nBody two"},
     "aligns": ["center", "left", "left"]},
    {"name": "stale paragraphs read as the box",
     "element": {"id": "b", "type": "text", "text": "Title\nBody", "align": "right",
       "paragraphs": [{"align": "center"}, {}], "paragraphsText": "Other words"},
     "aligns": ["right", "right"]},
    {"name": "an older file",
     "element": {"id": "c", "type": "text", "text": "One\nTwo"},
     "aligns": ["center", "center"]},
    {"name": "centred heading over a left list",
     "element": {"id": "d", "type": "text", "text": "Plan\nShop\nCook", "align": "center",
       "paragraphs": [{}, {"list": "bullet", "align": "left"}, {"list": "bullet", "align": "left"}],
       "paragraphsText": "Plan\nShop\nCook"},
     "aligns": ["center", "left", "left"], "markers": [null, "•  ", "•  "]},
    {"name": "an align this build does not know is the box's",
     "element": {"id": "e", "type": "text", "text": "One\nTwo", "align": "justify",
       "paragraphs": [{"align": "middle"}, {"align": "right"}], "paragraphsText": "One\nTwo"},
     "aligns": ["justify", "right"]}
  ],
  "aligned": [
    {"name": "the caret's line centred",
     "element": {"id": "f", "type": "text", "text": "One\nTwo\nThree", "align": "left"},
     "lines": [0, 0], "align": "center",
     "boxAlign": "left", "paragraphs": [{"align": "center"}, {}, {}]},
    {"name": "every line chosen is the box",
     "element": {"id": "g", "type": "text", "text": "One\nTwo\nThree", "align": "left",
       "paragraphs": [{"align": "center"}, {}, {}], "paragraphsText": "One\nTwo\nThree"},
     "lines": [0, 2], "align": "right",
     "boxAlign": "right", "paragraphs": null},
    {"name": "back to the box's align",
     "element": {"id": "h", "type": "text", "text": "One\nTwo", "align": "left",
       "paragraphs": [{"align": "center"}, {}], "paragraphsText": "One\nTwo"},
     "lines": [0, 0], "align": "left",
     "boxAlign": "left", "paragraphs": null},
    {"name": "a list keeps its lines",
     "element": {"id": "i", "type": "text", "text": "Plan\nShop\nCook", "align": "center",
       "paragraphs": [{}, {"list": "bullet"}, {"list": "bullet"}], "paragraphsText": "Plan\nShop\nCook"},
     "lines": [1, 2], "align": "left",
     "boxAlign": "center", "paragraphs": [{}, {"list": "bullet", "align": "left"}, {"list": "bullet", "align": "left"}]},
    {"name": "box-wide drops every line's own",
     "element": {"id": "j", "type": "text", "text": "Plan\nShop\nCook", "align": "center",
       "paragraphs": [{}, {"list": "bullet", "align": "left"}, {"list": "bullet", "align": "left"}],
       "paragraphsText": "Plan\nShop\nCook"},
     "box": true, "align": "right",
     "boxAlign": "right", "paragraphs": [{}, {"list": "bullet"}, {"list": "bullet"}]}
  ],
  "pptx": {
    "element": {"id": "a", "type": "text", "text": "Title\nBody one\nBody two", "align": "left", "fontSize": 32, "w": 400,
      "paragraphs": [{"align": "center"}, {}, {"align": "right"}], "paragraphsText": "Title\nBody one\nBody two"},
    "algn": ["ctr", null, "r"]
  }
}
