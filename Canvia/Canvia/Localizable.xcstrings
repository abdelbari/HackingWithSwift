    "Fitting and alignment wait while the words follow a curve, a path or stand in columns." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتظر الملاءمة والمحاذاة ما دامت الكلمات تتبع منحنى أو مسارًا أو في أعمدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassen und Ausrichten warten, solange der Text einer Kurve oder einem Pfad folgt oder in Spalten steht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitting and alignment wait while the words follow a curve, a path or stand in columns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ajuste y la alineación esperan mientras las palabras sigan una curva o un trazado o estén en columnas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ajustement et l’alignement attendent tant que le texte suit une courbe, un tracé ou est en colonnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adattamento e allineamento restano in attesa mentre le parole seguono una curva, un tracciato o sono disposte in colonne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字がカーブやパスに沿っているときや段組みのときは、サイズ合わせと配置は待機します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ajuste e o alinhamento ficam em espera enquanto as palavras seguem uma curva, um caminho ou estão em colunas."
          }
        }
      }
    },
