    "Plays as the page ends. Several at once leave one after another, the first in last out." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغَّل عند انتهاء الصفحة. إذا كانت عدة عناصر معًا تغادر واحدًا تلو الآخر، الأول دخولًا آخر خروجًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird am Ende der Seite abgespielt. Mehrere verschwinden nacheinander, das erste zuletzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays as the page ends. Several at once leave one after another, the first in last out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reproduce cuando termina la página. Si hay varias a la vez, salen una tras otra: la primera en entrar, la última en salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se joue à la fin de la page. Plusieurs à la fois sortent l’un après l’autre, le premier entré sortant le dernier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si riproduce alla fine della pagina. Più elementi insieme escono uno dopo l’altro, il primo entrato è l’ultimo a uscire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページの終了時に再生されます。複数ある場合は、最初に入ったものが最後に出るように順に退場します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz quando a página termina. Vários ao mesmo tempo saem um após o outro, o primeiro a entrar é o último a sair."
          }
        }
      }
    },
    "Plays when the page is presented. Several at once arrive one after another." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغَّل عند عرض الصفحة. إذا كانت عدة عناصر معًا تصل واحدًا تلو الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird abgespielt, wenn die Seite präsentiert wird. Mehrere erscheinen nacheinander."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays when the page is presented. Several at once arrive one after another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reproduce cuando se presenta la página. Si hay varias a la vez, llegan una tras otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se joue quand la page est présentée. Plusieurs à la fois arrivent l’un après l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si riproduce quando la pagina viene presentata. Più elementi insieme entrano uno dopo l’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページを表示したときに再生されます。複数ある場合は順に登場します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz quando a página é apresentada. Vários ao mesmo tempo entram um após o outro."
          }
        }
      }
    },
