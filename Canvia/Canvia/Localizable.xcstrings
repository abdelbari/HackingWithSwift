        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone não está permitido. Você pode ativá-lo em Ajustes."
          }
        }
      }
    },
    "The minimum is not below the maximum, so the data's own range is used." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأدنى ليس أقل من الحد الأقصى، لذا يُستخدم نطاق البيانات نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Minimum liegt nicht unter dem Maximum, daher wird der eigene Bereich der Daten verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The minimum is not below the maximum, so the data's own range is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mínimo no es menor que el máximo, así que se usa el rango propio de los datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le minimum n’est pas inférieur au maximum, la plage des données est donc utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il minimo non è inferiore al massimo, quindi viene usato l’intervallo dei dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小値が最大値より小さくないため、データ自体の範囲を使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mínimo não está abaixo do máximo, então o intervalo dos próprios dados é usado."
          }
        }
      }
    },
    "The music was chosen on another phone and isn't on this one." : {
      "extractionState" : "manual",
