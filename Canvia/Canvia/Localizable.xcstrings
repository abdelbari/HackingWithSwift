    "Nothing is made for this exact size, so every template is fitted to it. It replaces this page; Undo brings it back." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شيء مصمَّم لهذا الحجم بالضبط، لذا يُلاءَم كل قالب معه. يحلّ محل هذه الصفحة؛ والتراجع يعيدها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für genau diese Größe gibt es nichts, daher wird jede Vorlage daran angepasst. Sie ersetzt diese Seite; „Rückgängig“ holt sie zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is made for this exact size, so every template is fitted to it. It replaces this page; Undo brings it back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada hecho para este tamaño exacto, así que todas las plantillas se ajustan a él. Reemplaza esta página; Deshacer la recupera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est conçu pour cette taille exacte, donc chaque modèle y est ajusté. Il remplace cette page ; Annuler la rétablit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’è nulla creato per queste dimensioni esatte, quindi ogni modello viene adattato. Sostituisce questa pagina; Annulla la ripristina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイズ専用のものはないため、すべてのテンプレートをこのサイズに合わせます。このページが置き換わりますが、元に戻すで復元できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi feito para este tamanho exato, então todos os modelos são ajustados a ele. Ele substitui esta página; Desfazer a traz de volta."
          }
        }
      }
    },
