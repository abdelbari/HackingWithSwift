    "Page 1 on the front, page 2 on the back. Print on both sides, flipping on the long edge." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصفحة 1 على الوجه الأمامي، والصفحة 2 على الخلفي. اطبع على الوجهين، مع القلب على الضلع الطويل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seite 1 auf der Vorderseite, Seite 2 auf der Rückseite. Beidseitig drucken, an der langen Kante wenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page 1 on the front, page 2 on the back. Print on both sides, flipping on the long edge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La página 1 en la cara delantera y la página 2 en la trasera. Imprime a doble cara, girando por el lado largo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page 1 au recto, page 2 au verso. Imprimez en recto verso, en retournant sur le bord long."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagina 1 sul fronte, pagina 2 sul retro. Stampa su entrambi i lati, girando sul lato lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 ページ目が表面、2 ページ目が裏面です。両面に印刷し、長辺で綴じます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Página 1 na frente, página 2 no verso. Imprima nos dois lados, virando pela borda longa."
          }
        }
      }
    },
