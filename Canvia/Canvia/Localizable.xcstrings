    "Export makes PNG, JPEG, PDF, SVG, PowerPoint, MP4 and GIF at any size, saves straight to Photos, copies to the clipboard, or prints. Choose this page, every page, or just the selection." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ التصدير PNG وJPEG وPDF وSVG وPowerPoint وMP4 وGIF بأي حجم، ويحفظ مباشرةً في الصور، وينسخ إلى الحافظة، أو يطبع. اختر هذه الصفحة أو كل الصفحات أو التحديد فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Exportieren“ erstellt PNG, JPEG, PDF, SVG, PowerPoint, MP4 und GIF in jeder Größe, speichert direkt in Fotos, kopiert in die Zwischenablage oder druckt. Wähle diese Seite, alle Seiten oder nur die Auswahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export makes PNG, JPEG, PDF, SVG, PowerPoint, MP4 and GIF at any size, saves straight to Photos, copies to the clipboard, or prints. Choose this page, every page, or just the selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar crea PNG, JPEG, PDF, SVG, PowerPoint, MP4 y GIF a cualquier tamaño, guarda directamente en Fotos, copia al portapapeles o imprime. Elige esta página, todas las páginas o solo la selección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter crée des PNG, JPEG, PDF, SVG, PowerPoint, MP4 et GIF à n’importe quelle taille, enregistre directement dans Photos, copie dans le presse-papiers ou imprime. Choisissez cette page, toutes les pages ou seulement la sélection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta crea PNG, JPEG, PDF, SVG, PowerPoint, MP4 e GIF in qualsiasi dimensione, salva direttamente in Foto, copia negli appunti o stampa. Scegli questa pagina, tutte le pagine o solo la selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出しでは、PNG、JPEG、PDF、SVG、PowerPoint、MP4、GIF を任意のサイズで作成し、写真に直接保存、クリップボードにコピー、または印刷できます。このページ、すべてのページ、選択範囲のみから選べます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar cria PNG, JPEG, PDF, SVG, PowerPoint, MP4 e GIF em qualquer tamanho, salva direto em Fotos, copia para a área de transferência ou imprime. Escolha esta página, todas as páginas ou só a seleção."
          }
        }
      }
    },
