    "These arrive in different ways. Pick one for them all, or None." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هذه بطرق مختلفة. اختر طريقة واحدة لها كلها، أو «بلا»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese erscheinen auf unterschiedliche Weise. Wähle eine für alle oder „Keine“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These arrive in different ways. Pick one for them all, or None."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos aparecen de formas distintas. Elige una para todos, o Ninguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces éléments apparaissent de façons différentes. Choisissez-en une pour tous, ou Aucune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi entrano in modi diversi. Scegline uno per tutti, oppure Nessuna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登場の仕方がそれぞれ異なります。すべてに 1 つ選ぶか、「なし」を選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes entram de formas diferentes. Escolha uma para todos ou Nenhum."
          }
        }
      }
    },
    "These come and go at different times." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هذه وتختفي في أوقات مختلفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese erscheinen und verschwinden zu unterschiedlichen Zeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These come and go at different times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos aparecen y desaparecen en momentos distintos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces éléments apparaissent et disparaissent à des moments différents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi entrano ed escono in momenti diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登場と退場のタイミングがそれぞれ異なります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes aparecem e desaparecem em momentos diferentes."
          }
        }
      }
    },
    "These leave in different ways. Pick one for them all, or No exit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغادر هذه بطرق مختلفة. اختر طريقة واحدة لها كلها، أو «بلا خروج»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese verschwinden auf unterschiedliche Weise. Wähle eine für alle oder „Kein Ausgang“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These leave in different ways. Pick one for them all, or No exit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos salen de formas distintas. Elige una para todos, o Sin salida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces éléments sortent de façons différentes. Choisissez-en une pour tous, ou Pas de sortie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi escono in modi diversi. Scegline uno per tutti, oppure Nessuna uscita."
