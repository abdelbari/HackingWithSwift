    "Export PNG, JPEG, PDF, SVG, a video or an animated GIF — or a print-ready PDF with bleed and crop marks. Present full screen from the menu." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدِّر PNG أو JPEG أو PDF أو SVG أو فيديو أو GIF متحركًا — أو PDF جاهزًا للطباعة مع هامش النزف وعلامات القص. واعرض بملء الشاشة من القائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere PNG, JPEG, PDF, SVG, ein Video oder ein animiertes GIF – oder eine druckfertige PDF mit Beschnittzugabe und Schnittmarken. Präsentiere im Vollbild über das Menü."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export PNG, JPEG, PDF, SVG, a video or an animated GIF — or a print-ready PDF with bleed and crop marks. Present full screen from the menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta PNG, JPEG, PDF, SVG, un vídeo o un GIF animado, o un PDF listo para imprimir con sangrado y marcas de corte. Presenta a pantalla completa desde el menú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez en PNG, JPEG, PDF, SVG, en vidéo ou en GIF animé, ou en PDF prêt à imprimer avec fond perdu et traits de coupe. Présentez en plein écran depuis le menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta PNG, JPEG, PDF, SVG, un video o una GIF animata, oppure un PDF pronto per la stampa con abbondanza e segni di taglio. Presenta a schermo intero dal menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG、JPEG、PDF、SVG、動画、アニメーション GIF、または塗り足しとトンボ付きの印刷用 PDF を書き出します。メニューから全画面でプレゼンテーションできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte PNG, JPEG, PDF, SVG, um vídeo ou um GIF animado — ou um PDF para impressão com sangria e marcas de corte. Apresente em tela cheia pelo menu."
          }
        }
      }
    },
