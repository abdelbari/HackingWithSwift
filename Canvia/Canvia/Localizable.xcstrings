    "This phone's spelling checker is off. Turn it on in Settings, under System, Languages, Spell checker — the one your keyboard uses — and check again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدقق الإملائي في هذا الهاتف متوقف. فعّله في الإعدادات، ضمن النظام، اللغات، المدقق الإملائي — الذي تستخدمه لوحة مفاتيحك — ثم تحقّق مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rechtschreibprüfung dieses Telefons ist aus. Aktiviere sie in den Einstellungen unter System, Sprachen, Rechtschreibprüfung – die, die deine Tastatur verwendet – und prüfe erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone's spelling checker is off. Turn it on in Settings, under System, Languages, Spell checker — the one your keyboard uses — and check again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El corrector ortográfico de este teléfono está desactivado. Actívalo en Ajustes, en Sistema, Idiomas, Corrector ortográfico (el que usa tu teclado) y vuelve a comprobar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le correcteur orthographique de ce téléphone est désactivé. Activez-le dans Paramètres, sous Système, Langues, Correcteur orthographique (celui qu’utilise votre clavier), puis vérifiez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il controllo ortografico di questo telefono è disattivato. Attivalo in Impostazioni, in Sistema, Lingue, Controllo ortografico (quello usato dalla tastiera) e verifica di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマートフォンのスペルチェッカーがオフです。設定の「システム」>「言語」>「スペルチェッカー」（キーボードで使用しているもの）でオンにしてから、もう一度チェックしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O corretor ortográfico deste celular está desativado. Ative-o em Configurações, em Sistema, Idiomas, Corretor ortográfico — o que o seu teclado usa — e verifique de novo."
          }
        }
      }
    },
    "This photo can't be opened, so it can't be adjusted." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر فتح هذه الصورة، لذا لا يمكن ضبطها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto lässt sich nicht öffnen und daher nicht anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This photo can't be opened, so it can't be adjusted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta foto no se puede abrir, así que no se puede ajustar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette photo ne peut pas être ouverte, donc elle ne peut pas être ajustée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa foto non può essere aperta, quindi non può essere regolata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この写真は開けないため、調整できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta foto não pode ser aberta, então não pode ser ajustada."
          }
        }
      }
    },
    "This photo can't be opened, so it can't be cropped." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر فتح هذه الصورة، لذا لا يمكن اقتصاصها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto kann nicht geöffnet und daher nicht zugeschnitten werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This photo can't be opened, so it can't be cropped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede abrir esta foto, así que no se puede recortar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir cette photo, elle ne peut donc pas être rognée."
          }
        },
        "it" : {
