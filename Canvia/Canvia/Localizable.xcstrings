    "Read by VoiceOver and written into SVG exports. Suggest asks the on-device classifier for a first draft." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرؤه VoiceOver ويُكتب في ملفات SVG المصدَّرة. يطلب «اقتراح» مسودة أولى من المصنِّف على الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird von VoiceOver vorgelesen und in SVG-Exporte geschrieben. „Vorschlagen“ lässt die Bilderkennung auf dem Gerät einen ersten Entwurf erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read by VoiceOver and written into SVG exports. Suggest asks the on-device classifier for a first draft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo lee VoiceOver y se escribe en las exportaciones SVG. Sugerir pide un primer borrador al clasificador del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lu par VoiceOver et écrit dans les exportations SVG. Suggérer demande un premier jet au classificateur de l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letto da VoiceOver e scritto nelle esportazioni SVG. Suggerisci chiede al classificatore sul dispositivo una prima bozza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver で読み上げられ、SVG の書き出しにも書き込まれます。「提案」を使うと、デバイス上の分類器が下書きを作成します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
