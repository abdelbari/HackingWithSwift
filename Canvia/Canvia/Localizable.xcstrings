    "Change the words and the colours. Tap anything on the page to select it; drag it to move it. Double-tap text to type in it where it sits, and a photo to crop it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر الكلمات والألوان. انقر على أي شيء في الصفحة لتحديده، واسحبه لنقله. انقر مرتين على النص للكتابة فيه في مكانه، وعلى الصورة لاقتصاصها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere Text und Farben. Tippe auf etwas auf der Seite, um es auszuwählen; ziehe es, um es zu verschieben. Tippe doppelt auf Text, um direkt darin zu schreiben, und auf ein Foto, um es zuzuschneiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the words and the colours. Tap anything on the page to select it; drag it to move it. Double-tap text to type in it where it sits, and a photo to crop it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia las palabras y los colores. Toca cualquier cosa de la página para seleccionarla; arrástrala para moverla. Toca dos veces un texto para escribir en él donde está, y una foto para recortarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez le texte et les couleurs. Touchez un élément de la page pour le sélectionner ; faites-le glisser pour le déplacer. Touchez deux fois un texte pour le modifier sur place, et une photo pour la rogner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia le parole e i colori. Tocca qualsiasi cosa nella pagina per selezionarla; trascinala per spostarla. Tocca due volte un testo per scriverci direttamente, e una foto per ritagliarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字と色を変更しましょう。ページ上のものをタップすると選択、ドラッグすると移動できます。テキストをダブルタップするとその場で入力でき、写真をダブルタップすると切り抜けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altere as palavras e as cores. Toque em qualquer item da página para selecioná-lo; arraste-o para movê-lo. Toque duas vezes em um texto para digitar nele onde está, e em uma foto para cortá-la."
          }
        }
      }
    },
