    "Guides always snap. Drag one to move it; press and hold it to type where it goes or to remove it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلتصق الخطوط الإرشادية دائمًا. اسحب أحدها لتحريكه؛ واضغط عليه مطولًا لكتابة موضعه أو لإزالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfslinien rasten immer ein. Ziehe eine, um sie zu verschieben; halte sie gedrückt, um ihre Position einzugeben oder sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guides always snap. Drag one to move it; press and hold it to type where it goes or to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las guías siempre ajustan. Arrastra una para moverla; mantenla pulsada para escribir dónde va o para quitarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les repères sont toujours magnétiques. Faites-en glisser un pour le déplacer ; maintenez-le pour saisir sa position ou le supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le guide agganciano sempre. Trascinane una per spostarla; tienila premuta per digitarne la posizione o per rimuoverla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ガイドには常にスナップします。ドラッグで移動、長押しで位置の入力または削除ができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As guias sempre encaixam. Arraste uma para movê-la; toque e segure para digitar onde ela fica ou para removê-la."
          }
        }
      }
    },
