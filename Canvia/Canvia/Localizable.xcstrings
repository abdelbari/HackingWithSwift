    "Columns share the page inside the margin, with the gutter between them. No rows adds columns only." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتقاسم الأعمدة الصفحة داخل الهامش، مع الفاصل بينها. بلا صفوف يضيف أعمدة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalten teilen sich die Seite innerhalb des Rands, mit dem Abstand dazwischen. Ohne Zeilen werden nur Spalten hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Columns share the page inside the margin, with the gutter between them. No rows adds columns only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las columnas se reparten la página dentro del margen, con el medianil entre ellas. Sin filas solo se añaden columnas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les colonnes se partagent la page à l’intérieur de la marge, avec la gouttière entre elles. Sans lignes, seules des colonnes sont ajoutées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le colonne si dividono la pagina entro il margine, con lo spazio tra di loro. Nessuna riga aggiunge solo colonne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列はマージンの内側でページを分け合い、間に段間を挟みます。行なしにすると列だけが追加されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As colunas dividem a página dentro da margem, com o espaçamento entre elas. Sem linhas, só adiciona colunas."
          }
        }
      }
    },
