    "Black on white, with room round it, so it scans. Change what it says, its colours and its margin later from Edit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسود على أبيض، مع مساحة حوله، ليمكن مسحه. غيّر محتواه وألوانه وهامشه لاحقًا من «تعديل»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwarz auf Weiß, mit Rand drumherum, damit er sich scannen lässt. Inhalt, Farben und Rand kannst du später unter „Bearbeiten“ ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Black on white, with room round it, so it scans. Change what it says, its colours and its margin later from Edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negro sobre blanco, con margen alrededor, para que se pueda escanear. Cambia su contenido, sus colores y su margen más tarde en Editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noir sur blanc, avec une marge autour pour être lisible. Modifiez plus tard son contenu, ses couleurs et sa marge depuis Modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nero su bianco, con spazio intorno, così si scansiona. Cambia il contenuto, i colori e il margine più tardi da Modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白地に黒、周りに余白があるので読み取れます。内容、色、余白は後から「編集」で変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preto no branco, com espaço ao redor, para ser lido. Mude o conteúdo, as cores e a margem depois em Editar."
          }
        }
      }
    },
