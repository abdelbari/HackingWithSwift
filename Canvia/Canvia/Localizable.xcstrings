    "Tap the + button. Templates, shapes, lines, text styles, photos, stickers and QR codes are all there, and the search box at the top searches every tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على زر +. القوالب والأشكال والخطوط وأنماط النص والصور والملصقات ورموز QR كلها هناك، ومربع البحث في الأعلى يبحث في كل علامات التبويب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Taste +. Vorlagen, Formen, Linien, Textstile, Fotos, Sticker und QR-Codes sind alle dort, und das Suchfeld oben durchsucht alle Tabs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the + button. Templates, shapes, lines, text styles, photos, stickers and QR codes are all there, and the search box at the top searches every tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón +. Plantillas, formas, líneas, estilos de texto, fotos, stickers y códigos QR están ahí, y el cuadro de búsqueda de arriba busca en todas las pestañas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton +. Modèles, formes, lignes, styles de texte, photos, autocollants et codes QR s’y trouvent tous, et le champ de recherche en haut cherche dans chaque onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante +. Modelli, forme, linee, stili di testo, foto, sticker e codici QR sono tutti lì, e la casella di ricerca in alto cerca in ogni scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ ボタンをタップします。テンプレート、図形、線、テキストスタイル、写真、ステッカー、QR コードがすべてそろっており、上部の検索ボックスですべてのタブを検索できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no botão +. Modelos, formas, linhas, estilos de texto, fotos, figurinhas e códigos QR estão todos lá, e a caixa de pesquisa no topo pesquisa em todas as abas."
          }
        }
      }
    },
