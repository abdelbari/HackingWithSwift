          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede ausgewählte Größe wird zu einem neuen Design neben „%@“, passend neu angeordnet. Es bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each size ticked becomes a new design beside “%@”, rearranged to fit. It stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tamaño marcado se convierte en un diseño nuevo junto a “%@”, reorganizado para que encaje. Ese diseño se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque taille cochée devient un nouveau design à côté de « %@ », réorganisé pour s’adapter. Celui-ci reste tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dimensione selezionata diventa un nuovo design accanto a “%@”, riorganizzato per adattarsi. Quello resta com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックした各サイズが、「%@」の隣に新しいデザインとして作成され、収まるように配置し直されます。元のデザインはそのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tamanho marcado vira um novo design ao lado de “%@”, reorganizado para caber. Ele continua como está."
          }
        }
      }
    },
    "Each stroke becomes its own element, to move, recolour or delete later. Two fingers still move the page. Tap Done when you have finished." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح كل ضربة عنصرًا مستقلًا، لتحريكه أو إعادة تلوينه أو حذفه لاحقًا. لا يزال إصبعان يحرّكان الصفحة. انقر على «تم» عند الانتهاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Strich wird ein eigenes Element, das du später verschieben, umfärben oder löschen kannst. Mit zwei Fingern verschiebst du weiterhin die Seite. Tippe auf „Fertig“, wenn du fertig bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each stroke becomes its own element, to move, recolour or delete later. Two fingers still move the page. Tap Done when you have finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada trazo se convierte en su propio elemento, para moverlo, cambiarle el color o eliminarlo después. Con dos dedos sigues moviendo la página. Toca Listo cuando termines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque trait devient un élément à part entière, à déplacer, recolorer ou supprimer plus tard. Deux doigts déplacent toujours la page. Touchez OK quand vous avez terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tratto diventa un elemento a sé, da spostare, ricolorare o eliminare in seguito. Con due dita sposti ancora la pagina. Tocca Fine quando hai finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ストロークは個別の素材になり、後から移動、色の変更、削除ができます。2 本指でページを動かせます。描き終わったら「完了」をタップします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada traço vira um elemento próprio, para mover, mudar de cor ou excluir depois. Dois dedos ainda movem a página. Toque em Concluído quando terminar."
          }
        }
      }
    },
    "Each stroke is a shape of its own: tap Done to stop drawing, then select one to recolour, resize or delete it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ضربة شكل مستقل: انقر على «تم» لإيقاف الرسم، ثم حدّد ضربة لإعادة تلوينها أو تغيير حجمها أو حذفها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Strich ist eine eigene Form: Tippe auf „Fertig“, um das Zeichnen zu beenden, und wähle dann einen aus, um ihn umzufärben, seine Größe zu ändern oder ihn zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each stroke is a shape of its own: tap Done to stop drawing, then select one to recolour, resize or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada trazo es una forma independiente: toca Listo para dejar de dibujar y luego selecciona uno para cambiarle el color o el tamaño o eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque trait est une forme à part entière : touchez OK pour arrêter de dessiner, puis sélectionnez-en un pour le recolorer, le redimensionner ou le supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tratto è una forma a sé: tocca Fine per smettere di disegnare, poi selezionane uno per ricolorarlo, ridimensionarlo o eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ストロークは個別の図形です。「完了」をタップして描画を終え、1 つ選択すると色の変更、サイズ変更、削除ができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada traço é uma forma própria: toque em Concluído para parar de desenhar e depois selecione um para mudar a cor, redimensionar ou excluir."
          }
        }
      }
    },
    "Each stroke is a shape: tap the pencil again to stop drawing, then select a stroke to recolour, resize or delete it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ضربة شكل مستقل: انقر على القلم مرة أخرى لإيقاف الرسم، ثم حدّد ضربة لإعادة تلوينها أو تغيير حجمها أو حذفها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Strich ist eine Form: Tippe erneut auf den Stift, um das Zeichnen zu beenden, und wähle dann einen Strich aus, um ihn umzufärben, seine Größe zu ändern oder ihn zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each stroke is a shape: tap the pencil again to stop drawing, then select a stroke to recolour, resize or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada trazo es una forma: vuelve a tocar el lápiz para dejar de dibujar y luego selecciona un trazo para cambiarle el color o el tamaño o eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque trait est une forme : touchez à nouveau le crayon pour arrêter de dessiner, puis sélectionnez un trait pour le recolorer, le redimensionner ou le supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tratto è una forma: tocca di nuovo la matita per smettere di disegnare, poi seleziona un tratto per ricolorarlo, ridimensionarlo o eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ストロークは図形です。もう一度鉛筆をタップして描画を終え、ストロークを選択すると色の変更、サイズ変更、削除ができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada traço é uma forma: toque no lápis de novo para parar de desenhar e depois selecione um traço para mudar a cor, redimensionar ou excluir."
          }
        }
      }
    },
