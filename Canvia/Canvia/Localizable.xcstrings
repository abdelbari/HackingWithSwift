    "Share it. Export the page as an image, the whole thing as a PDF, or the design itself to open on another phone — Android or iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاركه. صدِّر الصفحة كصورة، أو كل شيء كملف PDF، أو التصميم نفسه لفتحه على هاتف آخر — Android أو iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile es. Exportiere die Seite als Bild, alles als PDF oder das Design selbst, um es auf einem anderen Telefon zu öffnen – Android oder iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share it. Export the page as an image, the whole thing as a PDF, or the design itself to open on another phone — Android or iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compártelo. Exporta la página como imagen, todo como PDF o el propio diseño para abrirlo en otro teléfono, Android o iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez-le. Exportez la page en image, l’ensemble en PDF, ou le design lui-même pour l’ouvrir sur un autre téléphone, Android ou iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividilo. Esporta la pagina come immagine, tutto come PDF, o il design stesso da aprire su un altro telefono, Android o iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有しましょう。ページを画像として、全体を PDF として、またはデザイン自体を別のスマートフォン（Android または iPhone）で開けるように書き出せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe. Exporte a página como imagem, tudo como PDF ou o próprio design para abrir em outro celular — Android ou iPhone."
          }
        }
      }
    },
