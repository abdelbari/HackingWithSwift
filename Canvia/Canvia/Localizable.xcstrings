    "Getting busy? The Layers sheet in the menu lists everything on the page, top-most first." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ازدحمت الصفحة؟ تسرد ورقة الطبقات في القائمة كل ما في الصفحة، الأعلى أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird es voll? Die Ebenenübersicht im Menü listet alles auf der Seite auf, das oberste zuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting busy? The Layers sheet in the menu lists everything on the page, top-most first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está llenando? La hoja Capas del menú muestra todo lo que hay en la página, primero lo que está más arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça se complique ? La fenêtre Calques du menu liste tout ce qui est sur la page, du premier plan vers l’arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi elementi? Il pannello Livelli nel menu elenca tutto ciò che è nella pagina, dall’alto verso il basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要素が増えてきましたか？メニューの「レイヤー」シートに、ページ上のすべてが最前面から順に表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficando cheio? A folha Camadas, no menu, lista tudo o que há na página, de cima para baixo."
          }
        }
      }
    },
    "Getting busy? What's on this page, under ⋮ at the bottom, lists everything, top-most first." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ازدحمت الصفحة؟ يسرد «محتوى هذه الصفحة»، ضمن ⋮ في الأسفل، كل شيء، الأعلى أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird es voll? „Was ist auf dieser Seite“ unter ⋮ unten listet alles auf, das oberste zuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting busy? What's on this page, under ⋮ at the bottom, lists everything, top-most first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se está llenando? Qué hay en esta página, en ⋮ abajo, lo muestra todo, primero lo que está más arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça se complique ? Contenu de cette page, sous ⋮ en bas, liste tout, du premier plan vers l’arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi elementi? Contenuto della pagina, in ⋮ in basso, elenca tutto, dall’alto verso il basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要素が増えてきましたか？下部の ⋮ にある「このページの内容」に、すべてが最前面から順に表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficando cheio? O que há nesta página, em ⋮ embaixo, lista tudo, de cima para baixo."
          }
        }
      }
    },
