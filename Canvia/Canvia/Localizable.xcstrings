    "Logos appear in the Photos tab of Add, in every design." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الشعارات في علامة تبويب الصور ضمن «إضافة»، في كل تصميم."
