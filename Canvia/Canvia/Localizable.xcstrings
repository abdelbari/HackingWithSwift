    "Any element can cast a shadow or glow: pick a preset or set the colour, blur and offset yourself." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي عنصر أن يُلقي ظلًا أو توهجًا: اختر إعدادًا مسبقًا أو اضبط اللون والتمويه والإزاحة بنفسك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Element kann einen Schatten oder ein Leuchten haben: Wähle eine Vorgabe oder lege Farbe, Weichzeichnung und Versatz selbst fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any element can cast a shadow or glow: pick a preset or set the colour, blur and offset yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier elemento puede proyectar una sombra o un resplandor: elige un ajuste predefinido o define tú el color, el desenfoque y el desplazamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout élément peut projeter une ombre ou une lueur : choisissez un préréglage ou réglez vous-même la couleur, le flou et le décalage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento può proiettare un’ombra o un bagliore: scegli una preimpostazione o imposta tu colore, sfocatura e scostamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの素材にも影や光彩を付けられます。プリセットを選ぶか、色・ぼかし・オフセットを自分で設定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer elemento pode ter sombra ou brilho: escolha uma predefinição ou defina você mesmo a cor, o desfoque e o deslocamento."
          }
        }
      }
    },
