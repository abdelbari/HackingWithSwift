    "A new Doc of this design's headings, words, tables, charts and pictures. The design stays as it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستند جديد بعناوين هذا التصميم ونصوصه وجداوله ومخططاته وصوره. يبقى التصميم كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Dokument mit den Überschriften, Texten, Tabellen, Diagrammen und Bildern dieses Designs. Das Design bleibt, wie es ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new Doc of this design's headings, words, tables, charts and pictures. The design stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un documento nuevo con los títulos, textos, tablas, gráficos e imágenes de este diseño. El diseño no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
