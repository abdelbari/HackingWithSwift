    "New page. Swipe the pages bar to move between pages, and use its notes button for speaker notes and this page's timing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفحة جديدة. اسحب شريط الصفحات للتنقل بين الصفحات، واستخدم زر الملاحظات فيه لملاحظات المتحدث وتوقيت هذه الصفحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Seite. Wische über die Seitenleiste, um zwischen Seiten zu wechseln, und nutze ihre Notizen-Taste für Sprechernotizen und das Timing dieser Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New page. Swipe the pages bar to move between pages, and use its notes button for speaker notes and this page's timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva página. Desliza la barra de páginas para moverte entre páginas y usa su botón de notas para las notas del orador y el tiempo de esta página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelle page. Balayez la barre des pages pour passer d’une page à l’autre, et utilisez son bouton de notes pour les notes de l’orateur et la durée de cette page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuova pagina. Scorri la barra delle pagine per passare da una pagina all’altra e usa il suo pulsante note per le note del relatore e la durata di questa pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいページです。ページバーをスワイプしてページ間を移動し、ノートボタンでスピーカーノートとこのページのタイミングを設定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova página. Deslize a barra de páginas para passar de uma página a outra e use o botão de anotações dela para as anotações do apresentador e o tempo desta página."
          }
        }
      }
    },
    "New page. The page count at the bottom shows them all; Organise pages, under ⋮, moves, copies and deletes them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفحة جديدة. يعرض عدد الصفحات في الأسفل جميعها؛ و«تنظيم الصفحات»، ضمن ⋮، ينقلها وينسخها ويحذفها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Seite. Die Seitenanzahl unten zeigt alle an; „Seiten organisieren“ unter ⋮ verschiebt, kopiert und löscht sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New page. The page count at the bottom shows them all; Organise pages, under ⋮, moves, copies and deletes them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueva página. El contador de páginas de abajo las muestra todas; Organizar páginas, en ⋮, las mueve, copia y elimina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelle page. Le nombre de pages en bas les affiche toutes ; Organiser les pages, sous ⋮, les déplace, les copie et les supprime."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuova pagina. Il conteggio delle pagine in basso le mostra tutte; Organizza pagine, in ⋮, le sposta, copia ed elimina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいページです。下部のページ数ですべてのページを表示できます。⋮ にある「ページを整理」で、移動、コピー、削除ができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova página. O contador de páginas embaixo mostra todas; Organizar páginas, em ⋮, move, copia e exclui páginas."
          }
        }
      }
    },
