        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los componentes aparecen en la pestaña Elementos de Añadir, en todos los diseños, y se colocan a la mitad del ancho de la página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les composants apparaissent dans l’onglet Éléments d’Ajouter, dans chaque design, et s’insèrent à la moitié de la largeur de la page."
