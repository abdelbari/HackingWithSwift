        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrador. Arrastra sobre lo que quieras quitar y toca Borrar en la barra de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gomme. Faites glisser sur ce qui doit disparaître, puis touchez Effacer dans la barre ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gomma. Trascina su ciò che va tolto, poi tocca Cancella nella barra qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消しゴム。消したい部分をドラッグしてから、下のバーの「消去」をタップします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borracha. Arraste sobre o que deve sair e toque em Apagar na barra abaixo."
          }
        }
      }
    },
