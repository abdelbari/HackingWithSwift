    "Everything you add will be listed here, top-most first, and can be dragged into a new order." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُدرج هنا كل ما تضيفه، الأعلى أولًا، ويمكن سحبه لترتيب جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du hinzufügst, wird hier aufgelistet, das oberste zuerst, und lässt sich in eine neue Reihenfolge ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
