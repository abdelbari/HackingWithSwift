    "Cropping the graphic. Pull the corners and edges to show only part of it. Done and Cancel are in the bar below." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ اقتصاص الرسم. اسحب الزوايا والحواف لإظهار جزء منه فقط. «تم» و«إلغاء» في الشريط بالأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafik wird zugeschnitten. Ziehe an Ecken und Kanten, um nur einen Teil zu zeigen. „Fertig“ und „Abbrechen“ sind in der Leiste unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cropping the graphic. Pull the corners and edges to show only part of it. Done and Cancel are in the bar below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recortando el gráfico. Arrastra las esquinas y los bordes para mostrar solo una parte. Listo y Cancelar están en la barra de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recadrage du graphique. Tirez les coins et les bords pour n’en montrer qu’une partie. OK et Annuler sont dans la barre en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritaglio della grafica. Trascina angoli e bordi per mostrarne solo una parte. Fine e Annulla sono nella barra in basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフィックをトリミング中です。角や辺をドラッグすると一部だけを表示できます。「完了」と「キャンセル」は下のバーにあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortando o gráfico. Puxe os cantos e as bordas para mostrar só uma parte dele. Concluído e Cancelar estão na barra abaixo."
          }
        }
      }
    },
    "Cropping the photo" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقتصاص الصورة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto zuschneiden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cropping the photo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recortando la foto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rognage de la photo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritaglio della foto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を切り抜き中"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como cortar a foto"
          }
        }
      }
    },
    "Cropping the photo. Drag the picture to move it, pinch to zoom it, and pull the frame's corners and edges to trim it. Done and Cancel are in the bar below." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقتصاص الصورة. اسحب الصورة لتحريكها، وقرّب أو بعّد بإصبعين لتكبيرها، واسحب زوايا الإطار وحوافه لقصّها. «تم» و«إلغاء» في الشريط أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto wird zugeschnitten. Ziehe das Bild, um es zu verschieben, zoome mit zwei Fingern und ziehe an den Ecken und Kanten des Rahmens, um es zu beschneiden. „Fertig“ und „Abbrechen“ findest du in der Leiste unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cropping the photo. Drag the picture to move it, pinch to zoom it, and pull the frame's corners and edges to trim it. Done and Cancel are in the bar below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recortando la foto. Arrastra la imagen para moverla, pellizca para ampliarla y tira de las esquinas y los bordes del marco para recortarla. Listo y Cancelar están en la barra de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rognage de la photo. Faites glisser l’image pour la déplacer, pincez pour zoomer, et tirez les coins et les bords du cadre pour la recadrer. OK et Annuler se trouvent dans la barre ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritaglio della foto. Trascina l’immagine per spostarla, pizzica per ingrandirla e tira angoli e bordi della cornice per rifilarla. Fine e Annulla sono nella barra qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を切り抜き中です。画像をドラッグして移動、ピンチでズームし、フレームの角や辺を引いてトリミングします。「完了」と「キャンセル」は下のバーにあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortando a foto. Arraste a imagem para movê-la, faça o gesto de pinça para ampliá-la e puxe os cantos e as bordas da moldura para apará-la. Concluído e Cancelar ficam na barra abaixo."
          }
        }
      }
    },
