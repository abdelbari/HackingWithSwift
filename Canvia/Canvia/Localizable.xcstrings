    "The kit in use is the one every design is offered: its colours, its fonts in Add text and Document theme, and its logos." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجموعة المستخدمة هي التي تُعرض على كل تصميم: ألوانها، وخطوطها في «إضافة نص» و«سمة المستند»، وشعاراتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das verwendete Kit wird jedem Design angeboten: seine Farben, seine Schriften in „Text hinzufügen“ und „Dokumentthema“ und seine Logos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The kit in use is the one every design is offered: its colours, its fonts in Add text and Document theme, and its logos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El kit en uso es el que se ofrece en todos los diseños: sus colores, sus fuentes en Añadir texto y Tema del documento, y sus logotipos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le kit utilisé est celui proposé à chaque design : ses couleurs, ses polices dans Ajouter du texte et Thème du document, et ses logos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il kit in uso è quello proposto in ogni design: i suoi colori, i suoi font in Aggiungi testo e Tema del documento, e i suoi loghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用中のキットは、すべてのデザインで提供されるキットです：その色、「テキストを追加」と「ドキュメントテーマ」のフォント、ロゴ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kit em uso é o oferecido em todos os designs: as cores, as fontes em Adicionar texto e Tema do documento, e os logotipos."
          }
        }
      }
    },
    "The kit's palettes are offered first in every colour picker, each by name. Press and hold a swatch to remove it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض لوحات ألوان المجموعة أولًا في كل منتقي ألوان، كلٌّ باسمه. اضغط مطولًا على عيّنة لإزالتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Paletten des Kits werden in jeder Farbauswahl zuerst angeboten, jeweils mit Namen. Halte ein Farbfeld gedrückt, um es zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The kit's palettes are offered first in every colour picker, each by name. Press and hold a swatch to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las paletas del kit aparecen primero en todos los selectores de color, cada una por su nombre. Mantén pulsada una muestra para quitarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les palettes du kit sont proposées en premier dans chaque sélecteur de couleur, chacune par son nom. Maintenez une pastille pour la retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tavolozze del kit sono proposte per prime in ogni selettore colore, ciascuna per nome. Tieni premuto un campione per rimuoverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キットのパレットは、すべてのカラーピッカーで名前付きで最初に表示されます。色見本を長押しすると削除できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
