    "Drawing surface. Drag to draw a stroke; tap Done in the bar below to finish." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سطح الرسم. اسحب لرسم ضربة؛ وانقر على «تم» في الشريط أدناه للإنهاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichenfläche. Ziehen, um einen Strich zu zeichnen; tippe in der Leiste unten auf „Fertig“, um abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drawing surface. Drag to draw a stroke; tap Done in the bar below to finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superficie de dibujo. Arrastra para dibujar un trazo; toca Listo en la barra de abajo para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surface de dessin. Faites glisser pour tracer un trait ; touchez OK dans la barre ci-dessous pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superficie di disegno. Trascina per disegnare un tratto; tocca Fine nella barra qui sotto per terminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描画エリア。ドラッグしてストロークを描き、終わったら下のバーの「完了」をタップします。"
