    "%@. One file per page, numbered, so each can be posted on its own." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ملف لكل صفحة، مرقّم، ليمكن نشر كل منها على حدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Eine Datei pro Seite, nummeriert, damit jede einzeln gepostet werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. One file per page, numbered, so each can be posted on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Un archivo por página, numerado, para publicar cada uno por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Un fichier par page, numéroté, pour publier chacun séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Un file per pagina, numerato, così ognuna può essere pubblicata da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。ページごとに番号付きの 1 ファイルなので、それぞれ単独で投稿できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Um arquivo por página, numerado, para cada um ser publicado separadamente."
          }
        }
      }
    },
    "%@. Pictures and SVGs are a file a page; the PDF, video and GIF play them in order." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. الصور وملفات SVG ملف لكل صفحة؛ أما PDF والفيديو وGIF فتعرضها بالترتيب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Bilder und SVGs sind eine Datei pro Seite; PDF, Video und GIF zeigen sie der Reihe nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Pictures and SVGs are a file a page; the PDF, video and GIF play them in order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Las imágenes y los SVG son un archivo por página; el PDF, el vídeo y el GIF las reproducen en orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Les images et les SVG font un fichier par page ; le PDF, la vidéo et le GIF les lisent dans l’ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Immagini e SVG sono un file per pagina; PDF, video e GIF le riproducono in ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。画像と SVG は 1 ページ 1 ファイル、PDF・動画・GIF は順番に再生されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Imagens e SVGs geram um arquivo por página; o PDF, o vídeo e o GIF as mostram em ordem."
          }
        }
      }
    },
