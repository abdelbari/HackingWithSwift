    "Find and replace searches the text on every page and replaces in one undo step. Check spelling lists every word the dictionary does not know, with suggestions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث «بحث واستبدال» في نص كل صفحة ويستبدل في خطوة تراجع واحدة. ويسرد «التدقيق الإملائي» كل كلمة لا يعرفها القاموس، مع اقتراحات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Suchen und ersetzen“ durchsucht den Text auf allen Seiten und ersetzt in einem einzigen Rückgängig-Schritt. „Rechtschreibung prüfen“ listet alle Wörter auf, die das Wörterbuch nicht kennt, mit Vorschlägen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find and replace searches the text on every page and replaces in one undo step. Check spelling lists every word the dictionary does not know, with suggestions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar y reemplazar busca en el texto de todas las páginas y reemplaza en un solo paso que se puede deshacer. Revisar ortografía muestra cada palabra que el diccionario no conoce, con sugerencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher et remplacer parcourt le texte de chaque page et remplace en une seule étape d’annulation. Vérifier l’orthographe liste chaque mot inconnu du dictionnaire, avec des suggestions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova e sostituisci cerca il testo in ogni pagina e sostituisce in un unico passaggio annullabile. Controllo ortografico elenca ogni parola che il dizionario non conosce, con suggerimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「検索と置換」は全ページのテキストを検索し、1 回の元に戻す操作で戻せる形で置換します。「スペルチェック」は辞書にないすべての単語を候補とともに表示します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localizar e substituir pesquisa o texto em todas as páginas e substitui em uma única etapa de desfazer. Verificar ortografia lista todas as palavras que o dicionário não conhece, com sugestões."
          }
        }
      }
    },
