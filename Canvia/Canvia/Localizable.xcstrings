        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página dura %@ s, salvo que tenga su propio tiempo, con un acercamiento lento, y pasa directamente a la siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
