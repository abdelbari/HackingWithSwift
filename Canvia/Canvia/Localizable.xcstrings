    "Everything shrinks or grows together, centred, with margins where the shape changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتقلص كل شيء أو يكبر معًا، في المنتصف، مع هوامش حيث تغيّر الشكل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wird gemeinsam verkleinert oder vergrößert, zentriert, mit Rändern, wo sich die Form geändert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything shrinks or grows together, centred, with margins where the shape changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se encoge o crece a la vez, centrado, con márgenes donde cambió la forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout rétrécit ou s’agrandit ensemble, centré, avec des marges là où la forme a changé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
