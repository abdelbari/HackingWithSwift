    "Animations in the editor and Present; System follows the phone. Exports are unchanged." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحركات في المحرر والعرض؛ «النظام» يتبع الهاتف. لا تتغير عمليات التصدير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animationen im Editor und beim Präsentieren; System folgt dem Telefon. Exporte bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animations in the editor and Present; System follows the phone. Exports are unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animaciones en el editor y en Presentar; Sistema sigue al teléfono. Las exportaciones no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animations dans l'éditeur et en Présentation ; Système suit le téléphone. Les exports ne changent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animazioni nell'editor e in Presenta; Sistema segue il telefono. Le esportazioni non cambiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタとプレゼンテーションのアニメーション。「システム」は端末の設定に従います。書き出しは変わりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animações no editor e em Apresentar; Sistema segue o telefone. As exportações não mudam."
          }
        }
      }
    },
