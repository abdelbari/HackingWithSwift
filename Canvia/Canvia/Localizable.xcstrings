    "A reminder at the time, with the caption copied and the file made then — so later edits go with it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير في الموعد، مع نسخ التعليق وإنشاء الملف حينها — فتُضمَّن التعديلات اللاحقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
