    "Its colours, fonts and logos go from every design's brand kit. Designs keep what they already use." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال ألوانه وخطوطه وشعاراته من مجموعة العلامة التجارية لكل تصميم. تحتفظ التصاميم بما تستخدمه بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Farben, Schriften und Logos werden aus dem Brand Kit jedes Designs entfernt. Designs behalten, was sie bereits verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its colours, fonts and logos go from every design's brand kit. Designs keep what they already use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus colores, fuentes y logotipos se quitan del kit de marca de todos los diseños. Los diseños conservan lo que ya usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses couleurs, polices et logos sont retirés du kit de marque de chaque design. Les designs gardent ce qu’ils utilisent déjà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi colori, font e loghi vengono rimossi dal Brand Kit di ogni design. I design mantengono ciò che usano già."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その色、フォント、ロゴはすべてのデザインのブランドキットから削除されます。デザインですでに使われているものはそのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores, fontes e logotipos dele saem do kit de marca de todos os designs. Os designs mantêm o que já usam."
          }
        }
      }
    },
    "Its colours, fonts, and lists of logos, photos, graphics and templates go. Designs that use them keep them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال ألوانه وخطوطه وقوائم شعاراته وصوره ورسوماته وقوالبه. تحتفظ التصاميم التي تستخدمها بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Farben, Schriften und Listen von Logos, Fotos, Grafiken und Vorlagen werden entfernt. Designs, die sie verwenden, behalten sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its colours, fonts, and lists of logos, photos, graphics and templates go. Designs that use them keep them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan sus colores, fuentes y listas de logotipos, fotos, gráficos y plantillas. Los diseños que los usan los conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses couleurs, polices et listes de logos, photos, graphiques et modèles sont supprimées. Les designs qui les utilisent les conservent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi colori, font ed elenchi di loghi, foto, grafiche e modelli vengono rimossi. I design che li usano li mantengono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その色、フォント、ロゴ・写真・グラフィック・テンプレートの一覧が削除されます。それらを使っているデザインはそのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores, fontes e listas de logotipos, fotos, gráficos e modelos dele são removidas. Os designs que os usam continuam com eles."
          }
        }
      }
    },
