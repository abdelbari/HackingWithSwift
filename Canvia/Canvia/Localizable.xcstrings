    "Curved text grows taller as it bends — drag its corners if the box looks tight." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزداد ارتفاع النص المنحني كلما انحنى — اسحب زواياه إن بدا المربع ضيقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebogener Text wird beim Biegen höher – ziehe an den Ecken, wenn das Feld zu eng aussieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curved text grows taller as it bends — drag its corners if the box looks tight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto curvado gana altura al doblarse: arrastra sus esquinas si el cuadro se ve justo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte incurvé devient plus haut en se courbant : faites glisser ses coins si le cadre semble étroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo curvo diventa più alto mentre si piega: trascina gli angoli se la casella sembra stretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲線テキストは曲げるほど高くなります。ボックスが窮屈に見えたら角をドラッグしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto curvo fica mais alto conforme se curva — arraste os cantos se a caixa parecer apertada."
          }
        }
      }
    },
