        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um tamanho para um post, um story, um pôster ou um slide — ou um modelo com o layout pronto. Tudo é salvo automaticamente enquanto você trabalha."
          }
        }
