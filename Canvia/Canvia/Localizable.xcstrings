          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un diseño como plantilla desde Más y luego añádelo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un design comme modèle depuis Plus, puis ajoutez-le ici."
