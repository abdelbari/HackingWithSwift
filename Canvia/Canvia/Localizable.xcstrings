    "Drag the photo to move it, pinch to zoom it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب الصورة لتحريكها، وقرّب بإصبعين لتكبيرها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe das Foto, um es zu verschieben, und ziehe es mit zwei Fingern zum Zoomen."
          }
