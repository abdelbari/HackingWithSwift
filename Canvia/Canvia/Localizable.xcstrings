    "Hold a page and drag it to move it; ticked pages move together. Tap pages to tick them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على صفحة واسحبها لتحريكها؛ تتحرك الصفحات المحددة معًا. انقر على الصفحات لتحديدها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Seite gedrückt und ziehe sie, um sie zu verschieben; markierte Seiten werden zusammen verschoben. Tippe auf Seiten, um sie zu markieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a page and drag it to move it; ticked pages move together. Tap pages to tick them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una página y arrástrala para moverla; las páginas marcadas se mueven juntas. Toca las páginas para marcarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez une page et faites-la glisser pour la déplacer ; les pages cochées se déplacent ensemble. Touchez des pages pour les cocher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta una pagina e trascinala per spostarla; le pagine selezionate si spostano insieme. Tocca le pagine per selezionarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページを長押ししてドラッグすると移動できます。チェックしたページはまとめて移動します。ページをタップするとチェックが付きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure uma página e arraste para movê-la; páginas marcadas se movem juntas. Toque nas páginas para marcá-las."
          }
        }
      }
    },
