        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a foto para movê-la e belisque para dar zoom."
          }
        }
      }
    },
    "Drag the picture to move it, pinch to zoom it, and pull the frame's corners and edges to trim it" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب الصورة لتحريكها، وقرّب أو بعّد بإصبعين لتكبيرها، واسحب زوايا الإطار وحوافه لقصّها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
