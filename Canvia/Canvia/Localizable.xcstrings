  "strings" : {
    "Canvia uses your phone's language. To choose another for Canvia alone, open its page in the Settings app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Canvia لغة هاتفك. لاختيار لغة أخرى لـ Canvia وحده، افتح صفحته في تطبيق الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia verwendet die Sprache deines Telefons. Um nur für Canvia eine andere zu wählen, öffne die Seite der App in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia uses your phone's language. To choose another for Canvia alone, open its page in the Settings app."
