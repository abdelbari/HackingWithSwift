    "Mark a picture as a logo in the brand kit, and it is here in every design." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد صورة كشعار في مجموعة العلامة التجارية، وستكون هنا في كل تصميم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere ein Bild im Brand Kit als Logo, dann ist es in jedem Design hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark a picture as a logo in the brand kit, and it is here in every design."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca una imagen como logotipo en el kit de marca y estará aquí en todos los diseños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez une image comme logo dans le kit de marque, et elle sera ici dans chaque design."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegna un’immagine come logo nel Brand Kit e sarà qui in ogni design."
          }
