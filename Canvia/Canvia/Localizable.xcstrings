    },
    "%@, each a 300 dpi picture: no editable text or links, so a print shop gets no font surprises." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@، كل صفحة صورة بدقة 300 dpi: بلا نص أو روابط قابلة للتعديل، فلا تواجه المطبعة مفاجآت في الخطوط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, jeweils ein Bild mit 300 dpi: kein bearbeitbarer Text, keine Links – so erlebt die Druckerei keine Überraschungen mit Schriften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, each a 300 dpi picture: no editable text or links, so a print shop gets no font surprises."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, cada una como imagen a 300 ppp: sin texto ni enlaces editables, para que la imprenta no tenga sorpresas con las fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, chacune une image à 300 ppp : ni texte modifiable ni liens, donc aucune surprise de police chez l’imprimeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ognuna un’immagine a 300 dpi: niente testo o link modificabili, così la tipografia non ha sorprese con i font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、各ページ 300 dpi の画像：編集可能なテキストやリンクはないため、印刷所でフォントの問題が起きません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, cada uma uma imagem de 300 dpi: sem texto editável nem links, para a gráfica não ter surpresas com fontes."
          }
        }
      }
