    "Each size ticked becomes a new design beside this one, rearranged to fit. This design stays as it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح كل حجم محدد تصميمًا جديدًا بجانب هذا التصميم، مُعاد ترتيبه ليناسب. يبقى هذا التصميم كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede ausgewählte Größe wird zu einem neuen Design neben diesem, passend neu angeordnet. Dieses Design bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each size ticked becomes a new design beside this one, rearranged to fit. This design stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tamaño marcado se convierte en un diseño nuevo junto a este, reorganizado para que encaje. Este diseño se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque taille cochée devient un nouveau design à côté de celui-ci, réorganisé pour s’adapter. Ce design reste tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dimensione selezionata diventa un nuovo design accanto a questo, riorganizzato per adattarsi. Questo design resta com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックした各サイズが、このデザインの隣に新しいデザインとして作成され、収まるように配置し直されます。このデザインはそのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tamanho marcado vira um novo design ao lado deste, reorganizado para caber. Este design continua como está."
          }
        }
      }
    },
    "Each size ticked becomes a new design beside “%@”, rearranged to fit. It stays as it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
