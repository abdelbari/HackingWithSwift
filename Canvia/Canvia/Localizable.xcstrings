    "PNG only. Drops the page's own background rather than flattening it, so the export really has nothing behind it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG فقط. يُسقط خلفية الصفحة نفسها بدلًا من تسطيحها، فلا يكون خلف الملف المصدَّر شيء حقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur PNG. Lässt den eigenen Hintergrund der Seite weg, statt ihn zu reduzieren, damit der Export wirklich nichts dahinter hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG only. Drops the page's own background rather than flattening it, so the export really has nothing behind it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo PNG. Quita el fondo propio de la página en lugar de acoplarlo, para que la exportación no tenga nada detrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG uniquement. Retire l’arrière-plan propre à la page au lieu de l’aplatir, pour que l’exportation n’ait vraiment rien derrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo PNG. Rimuove lo sfondo della pagina invece di appiattirlo, così dietro all’esportazione non c’è davvero nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG のみ。ページ自体の背景を統合せずに取り除くため、書き出したファイルの後ろには本当に何もありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só PNG. Remove o fundo da própria página em vez de achatá-lo, para a exportação realmente não ter nada atrás."
          }
        }
      }
    },
    "PNG only: a JPG has no clear parts." : {
