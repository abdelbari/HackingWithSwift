    "Rotation snaps at every 45° and taps when it lands; keep turning to leave the snap. Position sets an exact angle." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلتصق التدوير عند كل 45° ويهتز عند الوصول؛ واصل التدوير لتجاوز الالتصاق. ويضبط «الموضع» زاوية دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Drehung rastet alle 45° ein und gibt dabei ein Tippen aus; dreh weiter, um das Einrasten zu verlassen. „Position“ legt einen genauen Winkel fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotation snaps at every 45° and taps when it lands; keep turning to leave the snap. Position sets an exact angle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotación se ajusta cada 45° y vibra al llegar; sigue girando para salir del ajuste. Posición define un ángulo exacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotation s’aimante tous les 45° avec un léger retour haptique ; continuez à tourner pour la libérer. Position définit un angle exact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotazione si aggancia ogni 45° e vibra quando si ferma; continua a ruotare per uscire dall’aggancio. Posizione imposta un angolo esatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回転は 45° ごとにスナップし、ぴったり合うと振動します。さらに回すとスナップが外れます。「配置」で正確な角度を設定できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rotação encaixa a cada 45° e vibra quando encaixa; continue girando para sair do encaixe. Posição define um ângulo exato."
          }
        }
      }
    },
