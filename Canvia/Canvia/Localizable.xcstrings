    },
    "This phone can't find a photo's subject, so this area's dials show only on an iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الهاتف العثور على العنصر الرئيسي في الصورة، لذلك لا تظهر مؤشرات هذه المنطقة إلا على iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Telefon kann das Motiv eines Fotos nicht finden, daher wirken die Regler dieses Bereichs nur auf einem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone can't find a photo's subject, so this area's dials show only on an iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono no puede encontrar el sujeto de una foto, así que los diales de esta zona solo se ven en un iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone ne sait pas trouver le sujet d'une photo : les réglages de cette zone ne s'affichent que sur un iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo telefono non riesce a trovare il soggetto di una foto, quindi le regolazioni di quest'area si vedono solo su un iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマートフォンでは写真の被写体を見つけられないため、この範囲の調整は iPhone でのみ表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este celular não consegue encontrar o objeto principal de uma foto, então os ajustes desta área só aparecem em um iPhone."
          }
        }
      }
    },
    "This phone draws %@ as Normal; it is kept, and shows on an iPhone or Android 10 and later." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسم هذا الهاتف %@ كـ «عادي»؛ ويُحتفظ به، ويظهر على iPhone أو Android 10 والإصدارات الأحدث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Telefon zeigt %@ als „Normal“ an; es bleibt erhalten und wird auf einem iPhone oder ab Android 10 angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone draws %@ as Normal; it is kept, and shows on an iPhone or Android 10 and later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono dibuja %@ como Normal; se conserva y se ve en un iPhone o en Android 10 y posteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone affiche %@ en Normal ; le réglage est conservé et s’affiche sur un iPhone ou sur Android 10 et versions ultérieures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo telefono disegna %@ come Normale; viene mantenuto e si vede su iPhone o su Android 10 e successivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマートフォンでは %@ を「標準」として描画します。設定は保持され、iPhone や Android 10 以降では表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este celular desenha %@ como Normal; o modo é mantido e aparece em um iPhone ou no Android 10 e posteriores."
          }
        }
      }
    },
    "This phone keeps the focus circle sharp; an iPhone keeps the subject itself sharp." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي هذا الهاتف دائرة التركيز واضحة؛ أما iPhone فيُبقي العنصر الرئيسي نفسه واضحًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Telefon hält den Fokuskreis scharf; ein iPhone hält das Motiv selbst scharf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone keeps the focus circle sharp; an iPhone keeps the subject itself sharp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono mantiene nítido el círculo de enfoque; un iPhone mantiene nítido el propio sujeto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone garde le cercle de mise au point net ; un iPhone garde le sujet lui-même net."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo telefono mantiene nitido il cerchio di messa a fuoco; un iPhone mantiene nitido il soggetto stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマートフォンではフォーカスの円をシャープに保ちます。iPhone では被写体自体をシャープに保ちます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este celular mantém nítido o círculo de foco; um iPhone mantém nítido o próprio objeto principal."
          }
        }
      }
    },
    "This phone's language" : {
