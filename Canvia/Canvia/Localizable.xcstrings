          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A curve or a path waits while the words stand in columns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una curva o un trazado esperan mientras las palabras estén en columnas."
          }
        },
        "fr" : {
          "stringUnit" : {
