    "Too small for its handles? Pinch on it with two fingers to resize it, and twist them to turn it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصغر من أن تستخدم مقابضه؟ اقرصه بإصبعين لتغيير حجمه، وأدرهما لتدويره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu klein für die Griffe? Ziehe zwei Finger darauf zusammen, um die Größe zu ändern, und drehe sie, um es zu drehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too small for its handles? Pinch on it with two fingers to resize it, and twist them to turn it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Demasiado pequeño para sus tiradores? Pellízcalo con dos dedos para cambiar su tamaño y gíralos para rotarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop petit pour ses poignées ? Pincez-le à deux doigts pour le redimensionner, et tournez-les pour le faire pivoter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo piccolo per le maniglie? Pizzicalo con due dita per ridimensionarlo e ruotale per girarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さくてハンドルを使いにくいときは、2 本指でピンチしてサイズを変え、ひねって回転できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequeno demais para as alças? Pince com dois dedos sobre ele para redimensioná-lo e gire-os para girá-lo."
          }
        }
      }
    },
