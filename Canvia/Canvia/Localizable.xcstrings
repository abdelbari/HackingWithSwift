    "Reflow keeps each element's place on the new page — a footer stays at the foot, a corner logo in its corner — and sizes follow the smaller ratio." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحافظ إعادة الترتيب على مكان كل عنصر في الصفحة الجديدة — يبقى التذييل في الأسفل، والشعار في زاويته — وتتبع الأحجام النسبة الأصغر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Neu anordnen“ behält den Platz jedes Elements auf der neuen Seite – eine Fußzeile bleibt unten, ein Logo in seiner Ecke – und Größen folgen dem kleineren Verhältnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reflow keeps each element's place on the new page — a footer stays at the foot, a corner logo in its corner — and sizes follow the smaller ratio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reajustar mantiene el lugar de cada elemento en la nueva página (un pie de página se queda abajo, un logotipo en una esquina se queda en su esquina) y los tamaños siguen la proporción menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réorganiser garde la place de chaque élément sur la nouvelle page (un pied de page reste en bas, un logo dans son coin) et les tailles suivent le plus petit rapport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riorganizza mantiene la posizione di ogni elemento nella nuova pagina (un piè di pagina resta in fondo, un logo d’angolo nel suo angolo) e le dimensioni seguono il rapporto minore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再配置では、新しいページでも各素材の位置が保たれ（フッターは下に、角のロゴは角に）、サイズは小さい方の比率に合わせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reorganizar mantém o lugar de cada elemento na nova página — um rodapé fica embaixo, um logotipo de canto fica no canto — e os tamanhos seguem a menor proporção."
          }
        }
      }
    },
