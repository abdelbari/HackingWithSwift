    "Tap Add at the bottom for text, photos and videos, shapes, stickers, lines, charts, tables and QR codes. Photos can also be dropped in from another app, or pasted." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على «إضافة» في الأسفل للنصوص والصور ومقاطع الفيديو والأشكال والملصقات والخطوط والمخططات والجداول ورموز QR. ويمكن أيضًا إفلات الصور من تطبيق آخر أو لصقها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe unten auf „Hinzufügen“ für Text, Fotos und Videos, Formen, Sticker, Linien, Diagramme, Tabellen und QR-Codes. Fotos lassen sich auch aus einer anderen App hineinziehen oder einfügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Add at the bottom for text, photos and videos, shapes, stickers, lines, charts, tables and QR codes. Photos can also be dropped in from another app, or pasted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Añadir abajo para texto, fotos y vídeos, formas, stickers, líneas, gráficos, tablas y códigos QR. Las fotos también se pueden soltar desde otra app o pegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Ajouter en bas pour du texte, des photos et vidéos, des formes, des autocollants, des lignes, des graphiques, des tableaux et des codes QR. Les photos peuvent aussi être déposées depuis une autre app, ou collées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Aggiungi in basso per testo, foto e video, forme, sticker, linee, grafici, tabelle e codici QR. Le foto si possono anche trascinare da un’altra app o incollare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下部の「追加」をタップすると、テキスト、写真と動画、図形、ステッカー、線、グラフ、表、QR コードを追加できます。写真は他のアプリからドロップしたり、貼り付けたりすることもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Adicionar, embaixo, para texto, fotos e vídeos, formas, figurinhas, linhas, gráficos, tabelas e códigos QR. Também dá para soltar fotos vindas de outro app, ou colá-las."
          }
        }
      }
    },
    "Tap Add to put something on it, or start from a finished design." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على «إضافة» لوضع شيء فيها، أو ابدأ من تصميم جاهز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Hinzufügen“, um etwas darauf zu platzieren, oder beginne mit einem fertigen Design."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Add to put something on it, or start from a finished design."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Añadir para poner algo en ella o empieza con un diseño terminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Ajouter pour y placer quelque chose, ou partez d’un design terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Aggiungi per inserirvi qualcosa, oppure parti da un design finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「追加」をタップして何かを配置するか、完成したデザインから始めましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Adicionar para colocar algo nela ou comece com um design pronto."
          }
        }
      }
    },
    "Tap a colour on the photo to clear it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على لون في الصورة لمسحه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Farbe im Foto, um sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a colour on the photo to clear it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un color de la foto para borrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une couleur de la photo pour l'effacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un colore della foto per rimuoverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真の色をタップすると消えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma cor da foto para removê-la."
          }
        }
      }
    },
    "Tap one to change only that colour." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على أحدها لتغيير ذلك اللون فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine, um nur diese Farbe zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap one to change only that colour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca uno para cambiar solo ese color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez-en une pour ne changer que cette couleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccane uno per cambiare solo quel colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 つをタップすると、その色だけを変更します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma para mudar só essa cor."
          }
        }
      }
    },
    "Tap one to swap it in. Touch and hold to add it as well." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على أحدها لاستبداله. اضغط مطولًا لإضافته أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe eines an, um es auszutauschen. Halte es gedrückt, um es zusätzlich hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap one to swap it in. Touch and hold to add it as well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca uno para cambiarlo. Mantén pulsado para añadirlo además."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez-en un pour l’échanger. Maintenez le doigt pour l’ajouter en plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un elemento per sostituirlo. Tieni premuto per aggiungerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップで入れ替え、長押しで追加します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um para trocá-lo. Mantenha pressionado para adicioná-lo também."
          }
        }
      }
    },
    "Tap something to paste the style" : {
