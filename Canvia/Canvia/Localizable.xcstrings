    "What's on this page" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتوى هذه الصفحة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist auf dieser Seite"
          }
        },
        "en" : {
