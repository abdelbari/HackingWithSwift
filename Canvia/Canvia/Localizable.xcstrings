    "Each element on the page moves in turn. An element's own animation is kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحرك كل عنصر في الصفحة بدوره. وتبقى الحركة الخاصة بالعنصر كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Element der Seite bewegt sich der Reihe nach. Die eigene Animation eines Elements bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each element on the page moves in turn. An element's own animation is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada elemento de la página se mueve por turnos. Se conserva la animación propia de cada elemento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément de la page s’anime à tour de rôle. L’animation propre d’un élément est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento della pagina si muove a turno. L’animazione propria di un elemento viene mantenuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ上の要素が順番に動きます。要素自体のアニメーションはそのまま残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada elemento da página se move por vez. A animação própria de um elemento é mantida."
          }
        }
      }
    },
    "Each one goes on a new page after this one. Hold one to use it on this page instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضاف كل قالب في صفحة جديدة بعد هذه الصفحة. اضغط مطولًا على أحدها لاستخدامه في هذه الصفحة بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede kommt auf eine neue Seite nach dieser. Halte eine gedrückt, um sie stattdessen auf dieser Seite zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each one goes on a new page after this one. Hold one to use it on this page instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada una va en una página nueva después de esta. Mantén pulsada una para usarla en esta página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun s’ajoute sur une nouvelle page après celle-ci. Maintenez-en un pour l’utiliser plutôt sur cette page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno va su una nuova pagina dopo questa. Tieni premuto su uno per usarlo invece in questa pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれこのページの後の新しいページに追加されます。このページで使うには長押ししてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um vai para uma nova página depois desta. Toque e segure um para usá-lo nesta página."
          }
        }
      }
    },
    "Each page as a picture, exactly as it looks." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل صفحة صورة، تمامًا كما تبدو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Seite als Bild, genau wie sie aussieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each page as a picture, exactly as it looks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página como una imagen, tal como se ve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque page en image, exactement comme elle est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pagina come immagine, esattamente com'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ページを見た目そのままの画像にします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página como uma imagem, exatamente como aparece."
          }
        }
      }
    },
    "Each page holds %@s unless it has its own time, and cuts to the next." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى كل صفحة %@ ث ما لم يكن لها وقتها الخاص، ثم تنتقل مباشرةً إلى التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Seite steht %@ s, sofern sie keine eigene Zeit hat, und schneidet dann zur nächsten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each page holds %@s unless it has its own time, and cuts to the next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página dura %@ s, salvo que tenga su propio tiempo, y pasa directamente a la siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque page dure %@ s sauf si elle a sa propre durée, puis passe directement à la suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pagina resta %@ s se non ha una durata propria, poi passa alla successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ページは個別の時間がなければ %@ 秒表示され、カットで次に切り替わります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página dura %@ s, a menos que tenha um tempo próprio, e corta para a seguinte."
          }
        }
      }
    },
    "Each page holds %@s unless it has its own time, and fades into the next." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى كل صفحة %@ ث ما لم يكن لها وقتها الخاص، ثم تتلاشى إلى التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Seite steht %@ s, sofern sie keine eigene Zeit hat, und blendet dann in die nächste über."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each page holds %@s unless it has its own time, and fades into the next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página dura %@ s, salvo que tenga su propio tiempo, y se funde con la siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque page dure %@ s sauf si elle a sa propre durée, puis passe en fondu à la suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pagina resta %@ s se non ha una durata propria, poi sfuma nella successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ページは個別の時間がなければ %@ 秒表示され、フェードで次に切り替わります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página dura %@ s, a menos que tenha um tempo próprio, e se dissolve na seguinte."
          }
        }
      }
    },
    "Each page holds %@s unless it has its own time, with a slow push in, and cuts to the next." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى كل صفحة %@ ث ما لم يكن لها وقتها الخاص، مع تقريب بطيء، ثم تنتقل مباشرةً إلى التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Seite steht %@ s, sofern sie keine eigene Zeit hat, mit langsamem Heranzoomen, und schneidet dann zur nächsten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each page holds %@s unless it has its own time, with a slow push in, and cuts to the next."
