      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما تصنعه — منشور أو ملصق أو بطاقة. معظم الأحجام تأتي مع تصاميم جاهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, was du erstellst – einen Beitrag, ein Poster, eine Karte. Die meisten Größen haben fertige Designs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick what you are making — a post, a poster, a card. Most sizes come with ready-made designs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué vas a crear: una publicación, un póster, una tarjeta. La mayoría de los tamaños incluyen diseños listos para usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce que vous créez : une publication, une affiche, une carte. La plupart des tailles sont fournies avec des designs prêts à l’emploi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa stai creando: un post, un poster, un biglietto. Quasi tutte le dimensioni hanno design pronti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作るものを選びましょう — 投稿、ポスター、カードなど。ほとんどのサイズにテンプレートが用意されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que você vai criar — um post, um pôster, um cartão. A maioria dos tamanhos vem com designs prontos."
          }
        }
      }
    },
