    "System follows your phone's light and dark setting." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع «النظام» إعداد الوضع الفاتح والداكن في هاتفك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt der Hell-/Dunkel-Einstellung deines Telefons."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System follows your phone's light and dark setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema sigue el ajuste de modo claro u oscuro de tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système suit le réglage clair ou sombre de votre téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue l’impostazione chiaro/scuro del telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム」は、スマートフォンのライト／ダーク設定に従います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue a configuração de modo claro e escuro do celular."
          }
