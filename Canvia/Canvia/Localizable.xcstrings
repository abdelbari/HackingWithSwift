    "Share a PNG, a JPG, a PDF, a video or an animated GIF — or a print-ready PDF with bleed and crop marks. Present full screen from the top bar." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك PNG أو JPG أو PDF أو فيديو أو GIF متحركًا — أو PDF جاهزًا للطباعة مع هامش النزف وعلامات القص. واعرض بملء الشاشة من الشريط العلوي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile ein PNG, ein JPG, eine PDF, ein Video oder ein animiertes GIF – oder eine druckfertige PDF mit Beschnittzugabe und Schnittmarken. Präsentiere im Vollbild über die obere Leiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share a PNG, a JPG, a PDF, a video or an animated GIF — or a print-ready PDF with bleed and crop marks. Present full screen from the top bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte un PNG, un JPG, un PDF, un vídeo o un GIF animado, o un PDF listo para imprimir con sangrado y marcas de corte. Presenta a pantalla completa desde la barra superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez un PNG, un JPG, un PDF, une vidéo ou un GIF animé, ou un PDF prêt à imprimer avec fond perdu et traits de coupe. Présentez en plein écran depuis la barre du haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi un PNG, un JPG, un PDF, un video o una GIF animata, oppure un PDF pronto per la stampa con abbondanza e segni di taglio. Presenta a schermo intero dalla barra in alto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG、JPG、PDF、動画、アニメーション GIF、または塗り足しとトンボ付きの印刷用 PDF を共有します。上部のバーから全画面でプレゼンテーションできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe um PNG, um JPG, um PDF, um vídeo ou um GIF animado — ou um PDF para impressão com sangria e marcas de corte. Apresente em tela cheia pela barra superior."
          }
        }
      }
    },
