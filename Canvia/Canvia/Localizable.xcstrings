        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga è \"Etichetta, x, y, dimensione\"; una prima riga di nomi, come \"Città, Dimensione, Prezzo, Persone\", li nomina."
