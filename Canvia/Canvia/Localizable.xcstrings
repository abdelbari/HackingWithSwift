    "Makes a new design for each size ticked, reflowed to fit, in the same folder. “%@” stays as it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ تصميمًا جديدًا لكل حجم محدد، مُعاد ترتيبه ليناسب، في المجلد نفسه. يبقى «%@» كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt ein neues Design für jede ausgewählte Größe, passend neu angeordnet, im selben Ordner. „%@“ bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makes a new design for each size ticked, reflowed to fit, in the same folder. “%@” stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un diseño nuevo por cada tamaño marcado, reajustado para que encaje, en la misma carpeta. “%@” se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un nouveau design pour chaque taille cochée, réorganisé pour s’adapter, dans le même dossier. « %@ » reste tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nuovo design per ogni dimensione selezionata, adattato, nella stessa cartella. “%@” resta com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックした各サイズごとに、同じフォルダーにレイアウトを調整した新しいデザインを作成します。「%@」はそのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um novo design para cada tamanho marcado, reorganizado para caber, na mesma pasta. “%@” continua como está."
          }
        }
      }
    },
