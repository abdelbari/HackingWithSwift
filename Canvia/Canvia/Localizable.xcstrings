    "Text, photos, shapes, stickers, charts and QR codes. Draw freehand with the pen, or drop pictures in from other apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصوص وصور وأشكال وملصقات ومخططات ورموز QR. ارسم بحرية بالقلم، أو أفلت الصور من تطبيقات أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text, Fotos, Formen, Sticker, Diagramme und QR-Codes. Zeichne freihändig mit dem Stift oder ziehe Bilder aus anderen Apps hinein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text, photos, shapes, stickers, charts and QR codes. Draw freehand with the pen, or drop pictures in from other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto, fotos, formas, stickers, gráficos y códigos QR. Dibuja a mano alzada con el bolígrafo o suelta imágenes desde otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte, photos, formes, autocollants, graphiques et codes QR. Dessinez à main levée avec le stylo, ou déposez des images depuis d’autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo, foto, forme, sticker, grafici e codici QR. Disegna a mano libera con la penna o trascina immagini da altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト、写真、図形、ステッカー、グラフ、QR コード。ペンでフリーハンドで描いたり、他のアプリから画像をドロップしたりできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto, fotos, formas, figurinhas, gráficos e códigos QR. Desenhe à mão livre com a caneta ou solte imagens vindas de outros apps."
          }
        }
      }
    },
    "Text, photos, shapes, stickers, charts and QR codes. Draw freehand with the pencil, drop pictures in from other apps, or scan a document straight onto the page." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصوص وصور وأشكال وملصقات ومخططات ورموز QR. ارسم بحرية بالقلم، أو أفلت الصور من تطبيقات أخرى، أو امسح مستندًا ضوئيًا مباشرةً إلى الصفحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text, Fotos, Formen, Sticker, Diagramme und QR-Codes. Zeichne freihändig mit dem Stift, ziehe Bilder aus anderen Apps hinein oder scanne ein Dokument direkt auf die Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text, photos, shapes, stickers, charts and QR codes. Draw freehand with the pencil, drop pictures in from other apps, or scan a document straight onto the page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto, fotos, formas, stickers, gráficos y códigos QR. Dibuja a mano alzada con el lápiz, suelta imágenes desde otras apps o escanea un documento directamente en la página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte, photos, formes, autocollants, graphiques et codes QR. Dessinez à main levée avec le crayon, déposez des images depuis d’autres apps, ou numérisez un document directement sur la page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testo, foto, forme, sticker, grafici e codici QR. Disegna a mano libera con la matita, trascina immagini da altre app o scansiona un documento direttamente nella pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト、写真、図形、ステッカー、グラフ、QR コード。鉛筆でフリーハンドで描いたり、他のアプリから画像をドロップしたり、書類をスキャンして直接ページに配置したりできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto, fotos, formas, figurinhas, gráficos e códigos QR. Desenhe à mão livre com o lápis, solte imagens vindas de outros apps ou digitalize um documento direto na página."
          }
        }
      }
    },
