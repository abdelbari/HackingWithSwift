      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التصميم وصوره، لفتحه في Canvia على هاتف آخر — Android أو iPhone — أو للاحتفاظ به كنسخة احتياطية."
