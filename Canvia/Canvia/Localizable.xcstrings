    "Set where each track starts, its trim, volume and fades under More > Audio." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط بداية كل مسار وقصّه ومستوى صوته وتلاشيه ضمن المزيد > الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege unter Mehr > Audio fest, wo jede Spur beginnt, ihre Kürzung, Lautstärke und Überblendungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set where each track starts, its trim, volume and fades under More > Audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define dónde empieza cada pista, su recorte, volumen y fundidos en Más > Audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez le début de chaque piste, son découpage, son volume et ses fondus dans Plus > Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta dove inizia ogni traccia, il taglio, il volume e le dissolvenze in Altro > Audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各トラックの開始位置、トリミング、音量、フェードは「その他 > オーディオ」で設定します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
