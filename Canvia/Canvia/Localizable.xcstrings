    "Components appear in the Elements tab of Add, in every design, and drop in at half the page's width." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر المكوّنات في علامة تبويب العناصر ضمن «إضافة»، في كل تصميم، وتُدرج بنصف عرض الصفحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komponenten erscheinen in jedem Design im Tab „Elemente“ von „Hinzufügen“ und werden mit halber Seitenbreite eingefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Components appear in the Elements tab of Add, in every design, and drop in at half the page's width."
