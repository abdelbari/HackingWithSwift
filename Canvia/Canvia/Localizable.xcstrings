    "Pick a size above or a template below to start. Everything saves itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر حجمًا أعلاه أو قالبًا أدناه للبدء. كل شيء يُحفظ تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle oben eine Größe oder unten eine Vorlage, um zu beginnen. Alles wird automatisch gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
