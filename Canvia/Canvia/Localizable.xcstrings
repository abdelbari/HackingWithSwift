    "A curve or a path waits while the words stand in columns." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتظر المنحنى أو المسار ما دامت الكلمات في أعمدة."
          }
        },
        "de" : {
          "stringUnit" : {
