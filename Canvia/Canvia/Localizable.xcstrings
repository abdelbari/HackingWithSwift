    "A backup into a folder you choose, daily or weekly, whenever something has changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخة احتياطية في مجلد تختاره، يوميًا أو أسبوعيًا، كلما تغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sicherung in einen Ordner deiner Wahl, täglich oder wöchentlich, sobald sich etwas geändert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup into a folder you choose, daily or weekly, whenever something has changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de seguridad en la carpeta que elijas, a diario o cada semana, siempre que algo haya cambiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde dans le dossier de votre choix, chaque jour ou chaque semaine, dès que quelque chose a changé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
