    "Pages can have sizes of their own — a story after a square post. Exports, the video and the PDF keep each page's shape." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يكون للصفحات أحجامها الخاصة — قصة بعد منشور مربع. تحافظ الملفات المصدَّرة والفيديو وPDF على شكل كل صفحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten können eigene Größen haben – eine Story nach einem quadratischen Beitrag. Exporte, das Video und die PDF behalten die Form jeder Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pages can have sizes of their own — a story after a square post. Exports, the video and the PDF keep each page's shape."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas pueden tener su propio tamaño: una historia después de una publicación cuadrada. Las exportaciones, el vídeo y el PDF mantienen la forma de cada página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages peuvent avoir leur propre taille : une story après une publication carrée. Les exportations, la vidéo et le PDF conservent le format de chaque page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine possono avere dimensioni proprie: una storia dopo un post quadrato. Le esportazioni, il video e il PDF mantengono la forma di ogni pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページごとに個別のサイズにできます（正方形の投稿の後にストーリーなど）。書き出し、動画、PDF では各ページの形が保たれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas podem ter tamanhos próprios — um story depois de um post quadrado. As exportações, o vídeo e o PDF mantêm o formato de cada página."
          }
        }
      }
    },
