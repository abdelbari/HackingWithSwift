    "EAN-13 and UPC-A take digits, their check digit worked out for you; Code 128 and Code 39 take words too." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقبل EAN-13 وUPC-A الأرقام مع حساب رقم التحقق تلقائيًا، ويقبل Code 128 وCode 39 الكلمات أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EAN-13 und UPC-A nehmen Ziffern, die Prüfziffer wird berechnet; Code 128 und Code 39 nehmen auch Wörter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EAN-13 and UPC-A take digits, their check digit worked out for you; Code 128 and Code 39 take words too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EAN-13 y UPC-A admiten cifras y calculan su dígito de control; Code 128 y Code 39 también admiten palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EAN-13 et UPC-A acceptent des chiffres, leur clé de contrôle calculée pour vous ; Code 128 et Code 39 acceptent aussi des mots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EAN-13 e UPC-A accettano cifre e calcolano la cifra di controllo; Code 128 e Code 39 accettano anche parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EAN-13 と UPC-A は数字を使い、チェックデジットは自動で計算されます。Code 128 と Code 39 は文字も使えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EAN-13 e UPC-A aceitam dígitos, com o dígito verificador calculado para você; Code 128 e Code 39 aceitam palavras também."
          }
        }
      }
    },
    "EAN-13 needs 12 or 13 digits" : {
