    "Gradient letters colour every word. Choose a colour for the text to colour words on their own." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حروف التدرج تلوّن كل الكلمات. اختر لونًا للنص لتلوين الكلمات منفردة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlaufsbuchstaben färben jedes Wort. Wähle eine Farbe für den Text, um Wörter einzeln zu färben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient letters colour every word. Choose a colour for the text to colour words on their own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras con degradado colorean todas las palabras. Elige un color para el texto para colorear palabras por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lettres en dégradé colorent tous les mots. Choisissez une couleur pour le texte afin de colorer des mots séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lettere con sfumatura colorano ogni parola. Scegli un colore per il testo per colorare le parole singolarmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラデーション文字はすべての単語に色を付けます。単語ごとに色を付けるには、テキストの色を選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras em degradê colorem todas as palavras. Escolha uma cor para o texto para colorir palavras individualmente."
