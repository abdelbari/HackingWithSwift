    "Check spelling also suggests curly quotes, an ellipsis for three full stops and a dash between numbers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقترح التدقيق الإملائي أيضًا علامات اقتباس منحنية، وعلامة حذف بدل ثلاث نقاط، وشرطة بين الأرقام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rechtschreibprüfung schlägt auch typografische Anführungszeichen, Auslassungspunkte statt drei Punkten und einen Gedankenstrich zwischen Zahlen vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check spelling also suggests curly quotes, an ellipsis for three full stops and a dash between numbers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisar ortografía también sugiere comillas tipográficas, puntos suspensivos en lugar de tres puntos y una raya entre números."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification orthographique suggère aussi des guillemets typographiques, des points de suspension à la place de trois points et un tiret entre les nombres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il controllo ortografico suggerisce anche virgolette tipografiche, i puntini di sospensione al posto di tre punti e un trattino tra i numeri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スペルチェックでは、カーリー引用符、3つのピリオドの代わりの三点リーダー、数字の間のダッシュも提案します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação ortográfica também sugere aspas curvas, reticências no lugar de três pontos e um traço entre números."
          }
        }
      }
    },
