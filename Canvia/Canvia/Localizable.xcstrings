    "This Android version shows shadows on straight text only. Exports and other phones show this one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إصدار Android هذا الظلال على النص المستقيم فقط. تعرض الملفات المصدَّرة والهواتف الأخرى هذا الظل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Android-Version zeigt Schatten nur bei geradem Text. Exporte und andere Telefone zeigen diesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Android version shows shadows on straight text only. Exports and other phones show this one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de Android solo muestra sombras en el texto recto. Las exportaciones y otros teléfonos sí muestran esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version d’Android n’affiche les ombres que sur le texte droit. Les exportations et les autres téléphones affichent celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di Android mostra le ombre solo sul testo dritto. Le esportazioni e gli altri telefoni mostrano questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Android バージョンでは、影は直線のテキストにのみ表示されます。書き出しや他のスマートフォンではこの影が表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão do Android mostra sombras só em texto reto. As exportações e outros celulares mostram esta."
          }
        }
      }
    },
    "This backup was made by a newer Canvia. Update Canvia to restore it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُنشئت هذه النسخة الاحتياطية بإصدار أحدث من Canvia. حدّث Canvia لاستعادتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sicherung wurde mit einer neueren Canvia-Version erstellt. Aktualisiere Canvia, um sie wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup was made by a newer Canvia. Update Canvia to restore it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad se hizo con una versión más reciente de Canvia. Actualiza Canvia para restaurarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde a été créée par une version plus récente de Canvia. Mettez à jour Canvia pour la restaurer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup è stato creato da una versione più recente di Canvia. Aggiorna Canvia per ripristinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップは新しいバージョンの Canvia で作成されました。復元するには Canvia をアップデートしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup foi feito por um Canvia mais novo. Atualize o Canvia para restaurá-lo."
          }
        }
      }
    },
