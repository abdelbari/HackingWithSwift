    "A version is kept every couple of minutes while you edit, and each time you leave the editor." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ إصدار كل دقيقتين تقريبًا أثناء التعديل، وفي كل مرة تغادر فيها المحرر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Bearbeiten wird alle paar Minuten eine Version gespeichert, außerdem jedes Mal, wenn du den Editor verlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A version is kept every couple of minutes while you edit, and each time you leave the editor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda una versión cada par de minutos mientras editas y cada vez que sales del editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une version est enregistrée toutes les deux minutes pendant que vous modifiez, et chaque fois que vous quittez l’éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene salvata una versione ogni paio di minuti mentre modifichi e ogni volta che esci dall’editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
