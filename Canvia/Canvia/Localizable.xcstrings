    "Numbers each element on the page in the order VoiceOver reads it: rows top to bottom, left to right." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرقّم كل عنصر في الصفحة بالترتيب الذي يقرؤه به VoiceOver: الصفوف من الأعلى إلى الأسفل، ومن اليسار إلى اليمين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nummeriert jedes Element auf der Seite in der Reihenfolge, in der VoiceOver es vorliest: Zeilen von oben nach unten, von links nach rechts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numbers each element on the page in the order VoiceOver reads it: rows top to bottom, left to right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numera cada elemento de la página en el orden en que lo lee VoiceOver: filas de arriba abajo, de izquierda a derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numérote chaque élément de la page dans l’ordre de lecture de VoiceOver : lignes de haut en bas, de gauche à droite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numera ogni elemento della pagina nell’ordine in cui lo legge VoiceOver: righe dall’alto in basso, da sinistra a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver が読み上げる順序で、ページ上の各素材に番号を付けます：行は上から下、左から右へ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numera cada elemento da página na ordem em que o VoiceOver o lê: linhas de cima para baixo, da esquerda para a direita."
          }
        }
      }
    },
