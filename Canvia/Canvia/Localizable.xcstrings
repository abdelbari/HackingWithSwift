    "This song isn't on this phone: it was chosen on another one. It plays there." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الأغنية ليست على هذا الهاتف: اختيرت على هاتف آخر. وتُشغَّل هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Song ist nicht auf diesem Telefon: Er wurde auf einem anderen gewählt. Dort wird er abgespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This song isn't on this phone: it was chosen on another one. It plays there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta canción no está en este teléfono: se eligió en otro. Se reproduce allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce morceau n’est pas sur ce téléphone : il a été choisi sur un autre. Il y est lu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo brano non è su questo telefono: è stato scelto su un altro. Viene riprodotto lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この曲はこのスマートフォンにはありません。別のスマートフォンで選ばれたもので、そちらでは再生されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta música não está neste celular: foi escolhida em outro. Ela toca lá."
          }
        }
      }
    },
    "This sound can't be enhanced, so it plays as it is." : {
