      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح هذا التصميم كما هو الآن، بكل صفحاته. تبقى التصاميم المنشأة منه سابقًا كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird zu diesem Design in seinem aktuellen Zustand, mit allen Seiten. Bereits daraus erstellte Designs bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It becomes this design as it is now, every page. Designs already made from it stay as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa a ser este diseño tal como está ahora, todas las páginas. Los diseños ya creados con ella se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il devient ce design tel qu’il est maintenant, toutes les pages. Les designs déjà créés à partir de lui restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
