    },
    "A first line of names, as in \"Quarter, North, South\", makes a series of each column after the first." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سطر أول من الأسماء، مثل «الربع، الشمال، الجنوب»، يجعل كل عمود بعد الأول سلسلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erste Zeile mit Namen wie „Quartal, Nord, Süd“ macht jede Spalte nach der ersten zu einer Datenreihe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A first line of names, as in \"Quarter, North, South\", makes a series of each column after the first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una primera línea de nombres, como “Trimestre, Norte, Sur”, crea una serie con cada columna después de la primera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une première ligne de noms, comme « Trimestre, Nord, Sud », crée une série pour chaque colonne après la première."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una prima riga di nomi, come in “Trimestre, Nord, Sud”, crea una serie per ogni colonna dopo la prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「四半期, 北, 南」のように 1 行目に名前を入れると、2 列目以降の各列が系列になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma primeira linha de nomes, como em “Trimestre, Norte, Sul”, cria uma série para cada coluna após a primeira."
          }
        }
      }
    },
    "A frame clips the photo to a shape. Square frames keep their proportions, so applying one squares the picture." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصّ الإطار الصورة على هيئة شكل. تحافظ الإطارات المربعة على نسبها، لذا يجعل تطبيقها الصورة مربعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rahmen schneidet das Foto auf eine Form zu. Quadratische Rahmen behalten ihre Proportionen, das Bild wird also quadratisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frame clips the photo to a shape. Square frames keep their proportions, so applying one squares the picture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un marco recorta la foto con una forma. Los marcos cuadrados mantienen sus proporciones, así que al aplicar uno la imagen queda cuadrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cadre découpe la photo selon une forme. Les cadres carrés gardent leurs proportions : en appliquer un rend l’image carrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cornice ritaglia la foto in una forma. Le cornici quadrate mantengono le proporzioni, quindi applicarne una rende quadrata l’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレームは写真を図形の形に切り抜きます。正方形のフレームは縦横比を保つため、適用すると画像が正方形になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma moldura recorta a foto em uma forma. Molduras quadradas mantêm as proporções, então aplicar uma deixa a imagem quadrada."
          }
        }
      }
    },
