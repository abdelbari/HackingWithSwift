    "Your uploads are among the photos & clips. Caches are exports already made; they are made again when needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفاتك المحمّلة ضمن الصور والمقاطع. وذاكرات التخزين المؤقت هي ملفات مصدَّرة سابقًا؛ وتُنشأ مجددًا عند الحاجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Uploads sind bei „Fotos & Clips“. Caches sind bereits erstellte Exporte; sie werden bei Bedarf neu erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your uploads are among the photos & clips. Caches are exports already made; they are made again when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus archivos subidos están entre las fotos y clips. Las cachés son exportaciones ya creadas; se vuelven a crear cuando hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos importations font partie des photos et extraits. Les caches sont des exportations déjà créées ; elles sont recréées si besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi caricamenti sono tra foto e clip. La cache contiene le esportazioni già create; vengono ricreate quando servono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードは「写真とクリップ」に含まれます。キャッシュは作成済みの書き出しファイルで、必要なときに再作成されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus uploads estão entre as fotos e clipes. Os caches são exportações já feitas; eles são refeitos quando necessário."
          }
        }
      }
    },
