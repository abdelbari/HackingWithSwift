    "Larger than the sheet at actual size — it will be clipped. Tile it instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكبر من الورقة بالحجم الفعلي — سيُقصّ. قسّمه إلى بلاطات بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Originalgröße größer als das Blatt – es wird abgeschnitten. Teile es stattdessen auf mehrere Blätter auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larger than the sheet at actual size — it will be clipped. Tile it instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es más grande que la hoja a tamaño real y se recortará. Divídelo en mosaico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus grand que la feuille à taille réelle : il sera coupé. Utilisez plutôt la mosaïque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più grande del foglio a dimensioni reali: verrà tagliato. Affiancalo su più fogli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際のサイズでは用紙より大きいため、切れてしまいます。代わりにタイル状に分割してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maior que a folha em tamanho real — vai ser cortado. Use lado a lado."
          }
        }
      }
    },
