    "Leaves out the page's own background, so nothing is behind the design." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبعد خلفية الصفحة نفسها، فلا يكون شيء خلف التصميم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt den eigenen Hintergrund der Seite weg, damit nichts hinter dem Design ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves out the page's own background, so nothing is behind the design."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite el fondo propio de la página, para que no haya nada detrás del diseño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclut l’arrière-plan propre à la page, pour que rien ne soit derrière le design."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esclude lo sfondo della pagina, così dietro al design non c’è nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ自体の背景を除外するため、デザインの後ろには何もありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa de fora o fundo da própria página, para não haver nada atrás do design."
          }
        }
      }
    },
