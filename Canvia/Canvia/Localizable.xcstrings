    "Turning snaps at every 45° with a tick; keep turning to leave the snap." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلتصق التدوير عند كل 45° مع نقرة؛ واصل التدوير لتجاوز الالتصاق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Drehung rastet alle 45° mit einem Klick ein; dreh weiter, um das Einrasten zu verlassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning snaps at every 45° with a tick; keep turning to leave the snap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El giro se ajusta cada 45° con una vibración; sigue girando para salir del ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotation s’aimante tous les 45° avec un clic ; continuez à tourner pour la libérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotazione si aggancia ogni 45° con uno scatto; continua a ruotare per uscire dall’aggancio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回転は 45° ごとにカチッとスナップします。さらに回すとスナップが外れます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao girar, encaixa a cada 45° com um clique; continue girando para sair do encaixe."
          }
        }
      }
    },
    "Twinkle (loop)" : {
