          "stringUnit" : {
            "state" : "translated",
            "value" : "退場の仕方がそれぞれ異なります。すべてに 1 つ選ぶか、「退場なし」を選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes saem de formas diferentes. Escolha uma para todos ou Sem saída."
          }
        }
      }
    },
    "They come first, under the kit's name, on Home and in Templates." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي أولًا، تحت اسم المجموعة، في الرئيسية وفي القوالب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie stehen an erster Stelle, unter dem Namen des Kits, auf der Startseite und unter „Vorlagen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They come first, under the kit's name, on Home and in Templates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparecen primero, con el nombre del kit, en Inicio y en Plantillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils apparaissent en premier, sous le nom du kit, sur l’accueil et dans Modèles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono per primi, sotto il nome del kit, nella Home e in Modelli."
          }
        },
