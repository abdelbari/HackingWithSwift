    "Canvia isn't allowed to add to your photo library. You can change that in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُسمح لـ Canvia بالإضافة إلى مكتبة صورك. يمكنك تغيير ذلك في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia darf nichts zu deiner Fotomediathek hinzufügen. Du kannst das in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia isn't allowed to add to your photo library. You can change that in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia no tiene permiso para añadir contenido a tu fototeca. Puedes cambiarlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia n’est pas autorisé à ajouter des éléments à votre photothèque. Vous pouvez modifier cela dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia non è autorizzata ad aggiungere elementi alla libreria foto. Puoi cambiarlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia には写真ライブラリへの追加が許可されていません。設定で変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Canvia não tem permissão para adicionar itens à sua fototeca. Você pode mudar isso em Ajustes."
          }
        }
      }
    },
    "Canvia needs permission to save into your photos" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Canvia إلى إذن للحفظ في صورك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia braucht die Berechtigung, in deinen Fotos zu speichern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia needs permission to save into your photos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia necesita permiso para guardar en tus fotos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia a besoin d’une autorisation pour enregistrer dans vos photos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia ha bisogno dell’autorizzazione per salvare nelle tue foto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia が写真に保存するには許可が必要です"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Canvia precisa de permissão para salvar nas suas fotos"
          }
        }
      }
    },
    "Canvia needs the microphone to record your talk." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Canvia إلى الميكروفون لتسجيل عرضك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia braucht das Mikrofon, um deinen Vortrag aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia needs the microphone to record your talk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia necesita el micrófono para grabar tu presentación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia a besoin du micro pour enregistrer votre présentation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia ha bisogno del microfono per registrare la tua presentazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレゼンを録音するにはマイクが必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Canvia precisa do microfone para gravar sua apresentação."
          }
        }
      }
    },
    "Canvia records a voice-over with the microphone. You can allow it in Settings, under Canvia." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل Canvia التعليق الصوتي باستخدام الميكروفون. يمكنك السماح بذلك في الإعدادات، ضمن Canvia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia nimmt Sprachaufnahmen mit dem Mikrofon auf. Du kannst es in den Einstellungen unter Canvia erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia records a voice-over with the microphone. You can allow it in Settings, under Canvia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia graba una voz en off con el micrófono. Puedes permitirlo en Ajustes, en Canvia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia enregistre une voix off avec le micro. Vous pouvez l’autoriser dans Réglages, sous Canvia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia registra una voce fuori campo con il microfono. Puoi consentirlo in Impostazioni, alla voce Canvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia はマイクでナレーションを録音します。設定の「Canvia」で許可できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Canvia grava narrações com o microfone. Você pode permitir isso em Ajustes, em Canvia."
          }
        }
      }
    },
    "Canvia uses the microphone to record your voice while the design plays. Nothing is recorded until the 3-2-1 count ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Canvia الميكروفون لتسجيل صوتك أثناء تشغيل التصميم. لا يُسجَّل شيء حتى ينتهي العد 3-2-1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia verwendet das Mikrofon, um deine Stimme aufzunehmen, während das Design abgespielt wird. Die Aufnahme beginnt erst nach dem Countdown 3-2-1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia uses the microphone to record your voice while the design plays. Nothing is recorded until the 3-2-1 count ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia usa el micrófono para grabar tu voz mientras se reproduce el diseño. No se graba nada hasta que termina la cuenta 3-2-1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia utilise le micro pour enregistrer votre voix pendant la lecture du design. Rien n’est enregistré avant la fin du décompte 3-2-1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia usa il microfono per registrare la tua voce mentre il design viene riprodotto. Non viene registrato nulla finché il conto alla rovescia 3-2-1 non finisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia はデザインの再生中にマイクで声を録音します。3-2-1 のカウントが終わるまでは何も録音されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Canvia usa o microfone para gravar sua voz enquanto o design é reproduzido. Nada é gravado até a contagem 3-2-1 terminar."
          }
        }
      }
    },
    "Canvia uses your phone's language. To choose another for Canvia alone, open its page in the Settings app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Canvia لغة هاتفك. لاختيار لغة أخرى لـ Canvia وحده، افتح صفحته في تطبيق الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia verwendet die Sprache deines Telefons. Um nur für Canvia eine andere zu wählen, öffne die Seite der App in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia uses your phone's language. To choose another for Canvia alone, open its page in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia usa el idioma de tu teléfono. Para elegir otro solo para Canvia, abre su página en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia utilise la langue de votre téléphone. Pour en choisir une autre pour Canvia uniquement, ouvrez sa page dans l’app Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia usa la lingua del telefono. Per sceglierne un’altra solo per Canvia, apri la sua pagina nell’app Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvia はスマートフォンの言語を使用します。Canvia だけ別の言語にするには、設定アプリで Canvia のページを開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Canvia usa o idioma do seu celular. Para escolher outro só para o Canvia, abra a página dele no app Ajustes."
          }
        }
      }
    },
