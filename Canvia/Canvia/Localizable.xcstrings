    "Every page from there on is locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل الصفحات من هناك فصاعدًا مقفلة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Seiten ab dort sind gesperrt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every page from there on is locked"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las páginas a partir de ahí están bloqueadas"
