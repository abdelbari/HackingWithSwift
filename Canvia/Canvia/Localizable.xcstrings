    },
    "Each palette is offered by name in the colour panel, in every design. Tap a colour to take it out." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض كل لوحة ألوان باسمها في لوحة الألوان، في كل تصميم. انقر على لون لإزالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Palette wird in jedem Design mit Namen im Farbbereich angeboten. Tippe auf eine Farbe, um sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each palette is offered by name in the colour panel, in every design. Tap a colour to take it out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada paleta aparece por su nombre en el panel de color, en todos los diseños. Toca un color para quitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque palette est proposée par son nom dans le panneau des couleurs, dans chaque design. Touchez une couleur pour la retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tavolozza è proposta per nome nel pannello dei colori, in ogni design. Tocca un colore per rimuoverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各パレットは、どのデザインでもカラーパネルに名前付きで表示されます。色をタップすると取り除きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada paleta aparece pelo nome no painel de cores, em todos os designs. Toque em uma cor para removê-la."
          }
        }
      }
    },
    "Each row is \"Label, x, y\"; a first line of names, as in \"City, Size, Price\", names x and y." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل صف هو «التسمية، x، y»؛ وسطر أول من الأسماء، مثل «المدينة، الحجم، السعر»، يسمّي x وy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile ist „Beschriftung, x, y“; eine erste Zeile mit Namen wie „Stadt, Größe, Preis“ benennt x und y."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each row is \"Label, x, y\"; a first line of names, as in \"City, Size, Price\", names x and y."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila es “Etiqueta, x, y”; una primera línea de nombres, como “Ciudad, Tamaño, Precio”, da nombre a x e y."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne est « Libellé, x, y » ; une première ligne de noms, comme « Ville, Taille, Prix », nomme x et y."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga è “Etichetta, x, y”; una prima riga di nomi, come in “Città, Dimensione, Prezzo”, dà il nome a x e y."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各行は「ラベル, x, y」です。「都市, サイズ, 価格」のように 1 行目に名前を入れると、x と y に名前が付きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada linha é “Rótulo, x, y”; uma primeira linha de nomes, como em “Cidade, Tamanho, Preço”, dá nome a x e y."
          }
        }
      }
    },
    "Each row is \"Label, x, y, size\"; a first line of names, as in \"City, Size, Price, People\", names them." : {
      "extractionState" : "manual",
      "localizations" : {
