    "Text reads against what is behind it, pictures say what they show, nothing is too small or flashes, and the layers read in order." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النص مقروء مقابل ما خلفه، والصور توضّح ما تعرضه، ولا شيء صغير جدًا أو وامض، والطبقات تُقرأ بالترتيب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text hebt sich vom Hintergrund ab, Bilder sagen, was sie zeigen, nichts ist zu klein oder blinkt, und die Ebenen werden in der richtigen Reihenfolge gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text reads against what is behind it, pictures say what they show, nothing is too small or flashes, and the layers read in order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto se lee bien sobre lo que tiene detrás, las imágenes dicen lo que muestran, nada es demasiado pequeño ni parpadea, y las capas se leen en orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte se lit bien sur ce qui est derrière, les images disent ce qu’elles montrent, rien n’est trop petit ni ne clignote, et les calques se lisent dans l’ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo si legge rispetto a ciò che ha dietro, le immagini dicono cosa mostrano, niente è troppo piccolo o lampeggia e i livelli si leggono in ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストは背景に対して読みやすく、画像には内容の説明があり、小さすぎるものや点滅するものはなく、レイヤーは正しい順序で読み上げられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto se destaca do que está atrás, as imagens dizem o que mostram, nada é pequeno demais nem pisca e as camadas são lidas em ordem."
          }
        }
      }
    },
