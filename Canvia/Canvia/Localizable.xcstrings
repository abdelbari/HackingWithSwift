        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une taille ci-dessus ou un modèle ci-dessous pour commencer. Tout s’enregistre automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
