    "This chart is locked. Tap Unlock to edit it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المخطط مقفل. انقر على «إلغاء القفل» لتعديله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Diagramm ist gesperrt. Tippe auf „Entsperren“, um es zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This chart is locked. Tap Unlock to edit it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gráfico está bloqueado. Toca Desbloquear para editarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce graphique est verrouillé. Touchez Déverrouiller pour le modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo grafico è bloccato. Tocca Sblocca per modificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグラフはロックされています。編集するには「ロック解除」をタップしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este gráfico está bloqueado. Toque em Desbloquear para editá-lo."
          }
        }
      }
    },
    "This chart is locked. Unlock it from More to edit it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
