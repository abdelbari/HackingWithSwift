    "Several selected: Align lines them up, and Group in More keeps them together." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدة عناصر محددة: «محاذاة» يصفّها، و«تجميع» ضمن «المزيد» يُبقيها معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere ausgewählt: „Ausrichten“ richtet sie aus, und „Gruppieren“ unter „Mehr“ hält sie zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Several selected: Align lines them up, and Group in More keeps them together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varios seleccionados: Alinear los alinea y Agrupar, en Más, los mantiene juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs éléments sélectionnés : Aligner les aligne, et Grouper dans Plus les garde ensemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più elementi selezionati: Allinea li mette in fila e Raggruppa in Altro li tiene insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数選択中：「整列」で揃え、「その他」の「グループ化」でまとめられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vários selecionados: Alinhar os coloca em linha e Agrupar, em Mais, os mantém juntos."
          }
        }
      }
    },
    "Several selected: drag a corner to resize them together, or Group them from the menu so they stay together." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدة عناصر محددة: اسحب زاوية لتغيير حجمها معًا، أو جمّعها من القائمة لتبقى معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere ausgewählt: Ziehe an einer Ecke, um ihre Größe gemeinsam zu ändern, oder gruppiere sie über das Menü, damit sie zusammenbleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Several selected: drag a corner to resize them together, or Group them from the menu so they stay together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varios seleccionados: arrastra una esquina para cambiarles el tamaño a la vez, o agrúpalos desde el menú para que sigan juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs éléments sélectionnés : faites glisser un coin pour les redimensionner ensemble, ou groupez-les depuis le menu pour qu’ils restent ensemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più elementi selezionati: trascina un angolo per ridimensionarli insieme, oppure raggruppali dal menu perché restino uniti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数選択中：角をドラッグしてまとめてサイズ変更するか、メニューからグループ化してまとめておけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vários selecionados: arraste um canto para redimensioná-los juntos ou agrupe-os pelo menu para que fiquem juntos."
          }
        }
      }
    },
