    "Flatten draws each PDF page as one 300-dpi picture: no editable text and no links, so a print shop gets no font surprises." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسم التسطيح كل صفحة PDF كصورة واحدة بدقة 300 dpi: بلا نص قابل للتعديل وبلا روابط، فلا تواجه المطبعة مفاجآت في الخطوط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Reduzieren“ zeichnet jede PDF-Seite als ein einziges Bild mit 300 dpi: kein bearbeitbarer Text und keine Links – so erlebt die Druckerei keine Überraschungen mit Schriften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flatten draws each PDF page as one 300-dpi picture: no editable text and no links, so a print shop gets no font surprises."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acoplar dibuja cada página del PDF como una imagen de 300 ppp: sin texto editable ni enlaces, para que la imprenta no tenga sorpresas con las fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplatir dessine chaque page du PDF comme une image à 300 ppp : ni texte modifiable ni liens, donc aucune surprise de police chez l’imprimeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appiattisci disegna ogni pagina del PDF come un’unica immagine a 300 dpi: niente testo modificabile e niente link, così la tipografia non ha sorprese con i font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「統合」では各 PDF ページを 300 dpi の 1 枚の画像として描画します。編集可能なテキストやリンクがないため、印刷所でフォントの問題が起きません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achatar desenha cada página do PDF como uma imagem de 300 dpi: sem texto editável e sem links, para a gráfica não ter surpresas com fontes."
          }
        }
      }
    },
