    "No earlier versions yet. One is kept every couple of minutes while you edit, and each time you leave the editor." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد إصدارات سابقة بعد. يُحفظ إصدار كل دقيقتين تقريبًا أثناء التعديل، وفي كل مرة تغادر فيها المحرر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine früheren Versionen. Beim Bearbeiten wird alle paar Minuten eine gespeichert, außerdem jedes Mal, wenn du den Editor verlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No earlier versions yet. One is kept every couple of minutes while you edit, and each time you leave the editor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay versiones anteriores. Se guarda una cada par de minutos mientras editas y cada vez que sales del editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de version antérieure. Une version est enregistrée toutes les deux minutes pendant que vous modifiez, et chaque fois que vous quittez l’éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna versione precedente. Ne viene salvata una ogni paio di minuti mentre modifichi e ogni volta che esci dall’editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のバージョンはまだありません。編集中は数分ごと、またエディタを閉じるたびに保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há versões anteriores. Uma é salva a cada dois minutos enquanto você edita e sempre que você sai do editor."
          }
        }
      }
