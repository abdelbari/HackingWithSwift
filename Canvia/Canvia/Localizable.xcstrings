        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila es \"Etiqueta, x, y, tamaño\"; una primera línea de nombres, como \"Ciudad, Tamaño, Precio, Personas\", les da nombre."
