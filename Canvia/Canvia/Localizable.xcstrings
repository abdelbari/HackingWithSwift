        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo diminui ou aumenta junto, centralizado, com margens onde o formato mudou."
          }
        }
      }
    },
    "Everything stays on your phone. No account, no internet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
