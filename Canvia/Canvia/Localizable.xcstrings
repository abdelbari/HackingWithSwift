          "stringUnit" : {
            "state" : "translated",
            "value" : "このデザインの見出し、文章、表、グラフ、画像から新しいドキュメントを作ります。デザインはそのままです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo documento com os títulos, textos, tabelas, gráficos e imagens deste design. O design continua como está."
          }
        }
      }
    },
    "A new design for each size ticked, reflowed to fit, in the same folder. This design stays as it is." : {
