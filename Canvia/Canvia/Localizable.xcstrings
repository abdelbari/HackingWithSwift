    "Your current design is kept as a version too, and restoring can be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتفظ بتصميمك الحالي كإصدار أيضًا، ويمكن التراجع عن الاستعادة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein aktuelles Design wird ebenfalls als Version gespeichert, und das Wiederherstellen lässt sich rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current design is kept as a version too, and restoring can be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu diseño actual también se guarda como versión, y la restauración se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre design actuel est aussi conservé comme version, et la restauration peut être annulée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche il design attuale viene conservato come versione, e il ripristino si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のデザインもバージョンとして保存され、復元は元に戻せます。"
