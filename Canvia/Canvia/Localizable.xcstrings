    "Scale it down or up" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصغيره أو تكبيره"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkleinern oder vergrößern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scale it down or up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducirlo o ampliarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réduire ou l’agrandir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riducilo o ingrandiscilo"
          }
        },
