    "Add text offers each role in its face. Document theme gives the largest text the first face set, the next size the next, and so on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض «إضافة نص» كل دور بخطه. ويمنح سمة المستند أكبر نص أول خط في المجموعة، والحجم التالي الخط التالي، وهكذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Text hinzufügen“ zeigt jede Rolle in ihrer Schrift. „Dokumentthema“ gibt dem größten Text die erste Schrift des Sets, der nächsten Größe die nächste und so weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add text offers each role in its face. Document theme gives the largest text the first face set, the next size the next, and so on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir texto muestra cada función con su fuente. Tema del documento asigna al texto más grande la primera fuente del conjunto, al siguiente tamaño la siguiente, y así sucesivamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter du texte propose chaque rôle dans sa police. Le thème du document donne au plus grand texte la première police, à la taille suivante la suivante, et ainsi de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi testo propone ogni ruolo nel suo font. Tema del documento assegna al testo più grande il primo font della serie, alla dimensione successiva il successivo e così via."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「テキストを追加」では各役割がそれぞれの書体で表示されます。「ドキュメントテーマ」では、最も大きい文字に 1 つ目の書体、次のサイズに 2 つ目、というように割り当てます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar texto mostra cada função com sua fonte. Tema do documento dá ao maior texto a primeira fonte do conjunto, ao tamanho seguinte a seguinte, e assim por diante."
          }
        }
      }
    },
