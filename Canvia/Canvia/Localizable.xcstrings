          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile ist „Beschriftung, x, y, Größe“; eine erste Zeile mit Namen, etwa „Stadt, Größe, Preis, Einwohner“, benennt sie."
          }
        },
        "en" : {
          "stringUnit" : {
