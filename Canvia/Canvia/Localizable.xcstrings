          "stringUnit" : {
            "state" : "translated",
            "value" : "縮小または拡大"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuir ou aumentar"
          }
        }
      }
    },
    "Scale shrinks or grows everything uniformly to fit, centred, leaving margins when the shape changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصغّر «التحجيم» كل شيء أو يكبّره بالتساوي ليناسب، في المنتصف، تاركًا هوامش عند تغيّر الشكل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Skalieren“ verkleinert oder vergrößert alles gleichmäßig, zentriert, und lässt Ränder, wenn sich die Form ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scale shrinks or grows everything uniformly to fit, centred, leaving margins when the shape changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escalar encoge o amplía todo de forma uniforme para que encaje, centrado, dejando márgenes cuando cambia la forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à l’échelle réduit ou agrandit tout uniformément pour l’ajuster, centré, en laissant des marges quand le format change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scala riduce o ingrandisce tutto in modo uniforme per adattarlo, centrato, lasciando margini quando la forma cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「拡大・縮小」では、すべてを均等に縮小・拡大して中央に収め、形が変わった部分には余白が入ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensionar diminui ou aumenta tudo por igual para caber, centralizado, deixando margens quando o formato muda."
          }
        }
      }
    },
