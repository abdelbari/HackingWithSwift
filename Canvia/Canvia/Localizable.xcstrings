    "Photos and graphics appear in the Brand tab of Add, in every design. Press and hold one to remove it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الصور والرسومات في علامة تبويب العلامة التجارية ضمن «إضافة»، في كل تصميم. اضغط مطولًا على أحدها لإزالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos und Grafiken erscheinen in jedem Design im Tab „Marke“ von „Hinzufügen“. Halte eines gedrückt, um es zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos and graphics appear in the Brand tab of Add, in every design. Press and hold one to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos y los gráficos aparecen en la pestaña Marca de Añadir, en todos los diseños. Mantén pulsado uno para quitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos et graphiques apparaissent dans l’onglet Marque d’Ajouter, dans chaque design. Maintenez-en un pour le retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto e grafiche compaiono nella scheda Brand di Aggiungi, in ogni design. Tienine premuta una per rimuoverla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真とグラフィックは、どのデザインでも「追加」の「ブランド」タブに表示されます。長押しすると削除できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos e gráficos aparecem na aba Marca de Adicionar, em todos os designs. Toque e segure um para removê-lo."
          }
        }
      }
    },
