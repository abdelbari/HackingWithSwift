    "Words sit inside the shape. Add words here, or double tap the shape, to type them on it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقع الكلمات داخل الشكل. أضف كلمات هنا، أو انقر مرتين على الشكل، لكتابتها عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text steht in der Form. Füge hier Text hinzu oder tippe doppelt auf die Form, um darauf zu schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Words sit inside the shape. Add words here, or double tap the shape, to type them on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras van dentro de la forma. Añade palabras aquí, o toca dos veces la forma, para escribirlas en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte se place dans la forme. Ajoutez du texte ici, ou touchez deux fois la forme, pour l’écrire dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parole stanno dentro la forma. Aggiungi parole qui, o tocca due volte la forma, per scriverle sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字は図形の中に配置されます。ここで文字を追加するか、図形をダブルタップして入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As palavras ficam dentro da forma. Adicione palavras aqui, ou toque duas vezes na forma, para digitá-las nela."
          }
        }
      }
    },
