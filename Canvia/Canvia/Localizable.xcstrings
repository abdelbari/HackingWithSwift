    "%@° — the picture turns inside its frame and grows to keep covering it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° — تدور الصورة داخل إطارها وتكبر لتبقى مغطّية له."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° – das Bild dreht sich in seinem Rahmen und wird größer, damit es ihn weiter ausfüllt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° — the picture turns inside its frame and grows to keep covering it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° — la imagen gira dentro de su marco y crece para seguir cubriéndolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° — l’image tourne dans son cadre et s’agrandit pour continuer à le couvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° — l’immagine ruota nella cornice e si ingrandisce per continuare a coprirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° — 画像がフレーム内で回転し、フレームを覆い続けるよう拡大されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@° — a imagem gira dentro da moldura e aumenta para continuar a preenchê-la."
          }
        }
      }
    },
